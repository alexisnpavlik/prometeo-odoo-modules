<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fuera de "Extra Rights" (solo debug): categoría propia con un único grupo
         = desplegable visible. El padre "Métricas" se repite en cada módulo de
         métricas con mismo nombre y secuencia; Odoo los agrupa en un solo bloque. -->
    <record id="module_category_metrics_parent" model="ir.module.category">
        <field name="name">Métricas</field>
        <field name="sequence">90</field>
    </record>

    <record id="module_category_metrics" model="ir.module.category">
        <field name="name">Cambios de Precio (Góndola)</field>
        <field name="parent_id" ref="module_category_metrics_parent"/>
    </record>

    <record id="group_price_change_metrics_user" model="res.groups">
        <field name="name">Acceso</field>
        <field name="category_id" ref="module_category_metrics"/>
        <field name="comment">Permite ver la lista de productos con precio cambiado recientemente y marcarlos como actualizados en góndola.</field>
    </record>

    <!-- Activa el acceso por defecto: todo usuario interno hereda el grupo. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_price_change_metrics_user'))]"/>
    </record>

    <record id="rule_price_log_company" model="ir.rule">
        <field name="name">product.price.log multi-company</field>
        <field name="model_id" ref="model_product_price_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
