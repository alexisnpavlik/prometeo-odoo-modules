<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- Ícono de ayuda con tooltip. Parámetro: tip -->
    <t t-name="inventory_dashboard_metrics.InfoTip">
        <div t-att-class="'info-tooltip-wrapper ' + (align or 'tooltip-right')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="info-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <div class="info-tooltip-text"><t t-esc="tip"/></div>
        </div>
    </t>

    <!-- Filtro multi-selección con búsqueda. Parámetros: field, title, allLabel, pluralLabel, placeholder -->
    <t t-name="inventory_dashboard_metrics.MultiSelect">
        <div class="input-group">
            <label><t t-esc="title"/></label>
            <div class="multiselect" t-on-click.stop="() => {}">
                <button type="button" class="multiselect-toggle" t-on-click="() => this.toggleFilterPanel(field)">
                    <span class="multiselect-label" t-esc="multiLabel(field, allLabel, pluralLabel)"/>
                    <span class="multiselect-caret">▾</span>
                </button>
                <div class="multiselect-panel" t-if="state.openFilter === field">
                    <input type="text" class="multiselect-search" t-att-placeholder="placeholder"
                           t-att-value="state.filterSearch[field]"
                           t-on-input="(ev) => this.onFilterSearchInput(field, ev)"/>
                    <label class="multiselect-option multiselect-all">
                        <input type="checkbox" t-if="draft[field].length === 0" checked="checked"
                               t-on-change="() => this.selectAllFilterValues(field)"/>
                        <input type="checkbox" t-else=""
                               t-on-change="() => this.selectAllFilterValues(field)"/>
                        <span t-esc="allLabel"/>
                    </label>
                    <div class="multiselect-list">
                        <t t-foreach="visibleOptions(field)" t-as="opt" t-key="opt[0] + '|' + isFilterSelected(field, opt[0])">
                            <label class="multiselect-option">
                                <input type="checkbox" t-att-checked="isFilterSelected(field, opt[0])"
                                       t-on-change="() => this.toggleFilterValue(field, opt[0])"/>
                                <span t-esc="opt[1]"/>
                            </label>
                        </t>
                        <div class="multiselect-empty" t-if="visibleOptions(field).length === 0">Sin resultados</div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="inventory_dashboard_metrics.DashboardTemplate">
        <div t-att-class="'inv-dashboard-wrap ' + (state.theme === 'light' ? 'theme-light' : '')">

            <!-- Sidebar de filtros: mismo formato que pos_management_metrics -->
            <aside t-att-class="'sidebar' + (state.showFilters ? ' open' : '')" id="sidebar">
                <button class="sidebar-close" t-on-click="toggleFilters" title="Cerrar filtros">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    <span>Cerrar filtros</span>
                </button>

                <div class="sidebar-brand">
                    <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    <div class="brand-text">
                        <h2>Stock Metrics</h2>
                        <span>Inventory Hub</span>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h3>Período de ventas</h3>
                    <div class="preset-dates">
                        <t t-foreach="periodPresets" t-as="days" t-key="days">
                            <button t-att-class="'btn-preset ' + (draft.period === days ? 'active' : '')"
                                    t-on-click="onPresetClick" t-att-data-period="days">Últimos <t t-esc="days"/> días</button>
                        </t>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h3>Filtros Avanzados</h3>

                    <t t-call="inventory_dashboard_metrics.MultiSelect">
                        <t t-set="field" t-value="'company'"/>
                        <t t-set="title" t-value="'Empresa'"/>
                        <t t-set="allLabel" t-value="'Todas las empresas'"/>
                        <t t-set="pluralLabel" t-value="'empresas seleccionadas'"/>
                        <t t-set="placeholder" t-value="'Buscar empresa...'"/>
                    </t>

                    <t t-call="inventory_dashboard_metrics.MultiSelect">
                        <t t-set="field" t-value="'status'"/>
                        <t t-set="title" t-value="'Estado'"/>
                        <t t-set="allLabel" t-value="'Todos los estados'"/>
                        <t t-set="pluralLabel" t-value="'estados seleccionados'"/>
                        <t t-set="placeholder" t-value="'Buscar estado...'"/>
                    </t>

                    <t t-call="inventory_dashboard_metrics.MultiSelect">
                        <t t-set="field" t-value="'vendor'"/>
                        <t t-set="title" t-value="'Proveedor'"/>
                        <t t-set="allLabel" t-value="'Todos los proveedores'"/>
                        <t t-set="pluralLabel" t-value="'proveedores seleccionados'"/>
                        <t t-set="placeholder" t-value="'Buscar proveedor...'"/>
                    </t>

                    <t t-call="inventory_dashboard_metrics.MultiSelect">
                        <t t-set="field" t-value="'category'"/>
                        <t t-set="title" t-value="'Categoría'"/>
                        <t t-set="allLabel" t-value="'Todas las categorías'"/>
                        <t t-set="pluralLabel" t-value="'categorías seleccionadas'"/>
                        <t t-set="placeholder" t-value="'Buscar categoría...'"/>
                    </t>

                    <div class="input-group">
                        <label>Producto</label>
                        <input type="text" placeholder="Buscar producto..." t-model="draft.search"/>
                    </div>
                </div>

                <div class="sidebar-footer">
                    <button class="btn btn-primary" t-on-click="applyFilters"><span>Aplicar</span></button>
                    <button class="btn btn-secondary" t-on-click="clearFilters"><span>Limpiar</span></button>
                </div>
            </aside>

            <main class="main-content">
                <header class="main-header">
                    <div class="header-left">
                        <button class="btn btn-secondary btn-icon-only" t-on-click="toggleTheme" t-att-title="state.theme === 'light' ? 'Modo Noche' : 'Modo Día'">
                            <t t-if="state.theme === 'light'">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                </svg>
                            </t>
                            <t t-else="">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="5"></circle>
                                    <line x1="12" y1="1" x2="12" y2="3"></line>
                                    <line x1="12" y1="21" x2="12" y2="23"></line>
                                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                    <line x1="1" y1="12" x2="3" y2="12"></line>
                                    <line x1="21" y1="12" x2="23" y2="12"></line>
                                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                                </svg>
                            </t>
                        </button>
                        <h1>Dashboard de Inventario y Stock</h1>
                    </div>

                    <div class="header-right">
                        <button class="sidebar-toggle" t-on-click="toggleFilters" title="Filtros">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <line x1="7" y1="12" x2="17" y2="12"></line>
                                <line x1="10" y1="18" x2="14" y2="18"></line>
                            </svg>
                        </button>

                        <div class="sync-status">
                            <span t-att-class="'status-dot ' + (state.loading ? 'anim-spin' : 'green')"></span>
                            <span class="status-text" t-esc="state.syncTime">Cargando...</span>
                        </div>

                        <button class="btn btn-secondary btn-icon-only" t-on-click="refreshData" title="Sincronizar ahora">
                            <svg t-att-class="state.loading ? 'icon-spin-target spinning' : 'icon-spin-target'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                            </svg>
                        </button>
                    </div>
                </header>

                <nav class="nav-tabs">
                    <button t-att-class="'nav-tab ' + (state.tab === 'stock' ? 'active' : '')" t-on-click="onTabClick" data-tab="stock">Stock</button>
                    <button t-att-class="'nav-tab ' + (state.tab === 'compra' ? 'active' : '')" t-on-click="onTabClick" data-tab="compra">Recomendador de compra</button>
                </nav>

                <div class="tab-content">

                    <!-- ============ TARJETAS POR ESTADO ============ -->
                    <div class="kpi-grid status-cards">
                        <t t-foreach="statusCards" t-as="card" t-key="card.key">
                            <button type="button" t-att-class="'kpi-card shadow-glow status-card ' + card.color + (state.status.includes(card.key) ? ' selected' : '') + (state.status.length and !state.status.includes(card.key) ? ' dimmed' : '')"
                                    t-on-click="onStatusCardClick" t-att-data-status="card.key"
                                    t-att-title="state.status.length === 1 and state.status[0] === card.key ? 'Quitar filtro' : 'Filtrar por ' + card.label">
                                <div class="kpi-card-inner">
                                    <div class="kpi-meta">
                                        <span class="kpi-title"><t t-esc="card.label"/></span>
                                        <div class="kpi-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <t t-if="card.key === 'sin_stock'">
                                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                                </t>
                                                <t t-elif="card.key === 'por_agotarse'">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <polyline points="12 6 12 12 16 14"></polyline>
                                                </t>
                                                <t t-elif="card.key === 'sin_venta'">
                                                    <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
                                                    <polyline points="17 18 23 18 23 12"></polyline>
                                                </t>
                                                <t t-elif="card.key === 'sobrestock'">
                                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                                    <polyline points="2 17 12 22 22 17"></polyline>
                                                    <polyline points="2 12 12 17 22 12"></polyline>
                                                </t>
                                                <t t-elif="card.key === 'urgente'">
                                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                </t>
                                                <t t-else="">
                                                    <circle cx="9" cy="21" r="1"></circle>
                                                    <circle cx="20" cy="21" r="1"></circle>
                                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                                </t>
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="kpi-value"><t t-esc="formatNumber(card.count)"/></div>
                                    <div class="kpi-footer">
                                        <span class="kpi-subtext">
                                            <t t-if="state.tab === 'compra'"><t t-esc="formatCurrency(card.amount)"/> a comprar</t>
                                            <t t-elif="card.amount"><t t-esc="formatCurrency(card.amount)"/> de más</t>
                                            <t t-else="">productos</t>
                                        </span>
                                    </div>
                                </div>
                            </button>
                        </t>
                    </div>

                    <!-- ============ POR REPONER ============ -->
                    <section class="tab-pane active" t-if="state.tab === 'stock' and showRestock">
                        <div class="glass-panel padded">
                            <div class="section-header">
                                <div>
                                    <h3>Productos por reponer</h3>
                                    <p class="section-sub">
                                        <t t-esc="formatNumber(filteredRestock.length)"/> productos que se venden y no tienen stock
                                        o les quedan <t t-esc="lowCoverDays"/> días o menos
                                    </p>
                                </div>
                                <t t-call="inventory_dashboard_metrics.InfoTip">
                                    <t t-set="tip" t-value="'Para saber cuánto comprar de cada uno, usá la pestaña Recomendador de compra. Un stock negativo suele indicar ventas registradas sin la entrada de mercadería.'"/>
                                </t>
                            </div>
                            <div class="filter-row">
                                <button class="btn btn-secondary" t-on-click="exportExcel" data-table="restock">Exportar Excel</button>
                            </div>
                            <div class="table-responsive">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th class="sortable" t-on-click="onSortClick" data-table="rest" data-key="producto">Producto<span class="sort-mark" t-esc="sortMark('rest', 'producto')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="rest" data-key="categoria">Categoría<span class="sort-mark" t-esc="sortMark('rest', 'categoria')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="rest" data-key="vendor">Proveedor<span class="sort-mark" t-esc="sortMark('rest', 'vendor')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="rest" data-key="stock">Stock<span class="sort-mark" t-esc="sortMark('rest', 'stock')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="rest" data-key="sold">Vendidas (<t t-esc="state.period"/> d)<span class="sort-mark" t-esc="sortMark('rest', 'sold')"/></th>
                                            <th class="sortable num th-wrap" t-on-click="onSortClick" data-table="rest" data-key="daily">Promedio de ventas por día<span class="sort-mark" t-esc="sortMark('rest', 'daily')"/></th>
                                            <th class="sortable num th-highlight" t-on-click="onSortClick" data-table="rest" data-key="cover">Alcanza para<span class="sort-mark" t-esc="sortMark('rest', 'cover')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="rest" data-key="status">Estado<span class="sort-mark" t-esc="sortMark('rest', 'status')"/></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="restPage.rows.length === 0">
                                            <td colspan="8" class="text-center text-muted empty-row">No hay productos para reponer con estos filtros.</td>
                                        </tr>
                                        <t t-foreach="restPage.rows" t-as="r" t-key="r.product_id">
                                            <tr>
                                                <td class="cell-strong cell-text"><t t-esc="r.producto"/></td>
                                                <td class="cell-secondary"><t t-esc="r.categoria"/></td>
                                                <td class="cell-secondary"><t t-esc="r.vendor"/></td>
                                                <td class="num">
                                                    <t t-esc="formatNumber(r.stock)"/>
                                                    <span t-if="r.stock &lt; 0" class="review-tag" title="Stock negativo: falta registrar una entrada de mercadería o un conteo. Para calcular la compra se toma como 0.">revisar</span>
                                                </td>
                                                <td class="num">
                                                    <t t-esc="formatNumber(r.sold)"/>
                                                    <div t-if="r.days &lt; periodDays" class="cell-note muted" title="El producto tiene menos historia que el período: el promedio se calcula sobre estos días.">en <t t-esc="r.days"/> días</div>
                                                </td>
                                                <td class="num"><t t-esc="formatDaily(r.daily)"/></td>
                                                <td class="num"><span t-att-class="coverClass(r.cover)"><t t-esc="formatNumber(r.cover)"/> días</span></td>
                                                <td><span t-att-class="'stock-badge ' + (r.status === 'sin_stock' ? 'rotura' : 'critico')"><t t-esc="r.status === 'sin_stock' ? 'Sin stock' : 'Por agotarse'"/></span></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="pagination" t-if="restPage.pages &gt; 1">
                                <button class="btn btn-secondary" t-att-disabled="restPage.current &lt;= 1" t-on-click="changePage" data-key="restPage" data-dir="-1">Anterior</button>
                                <span class="page-info">Página <t t-esc="restPage.current"/> de <t t-esc="restPage.pages"/></span>
                                <button class="btn btn-secondary" t-att-disabled="restPage.current &gt;= restPage.pages" t-on-click="changePage" data-key="restPage" data-dir="1">Siguiente</button>
                            </div>
                        </div>
                    </section>

                    <!-- ============ MUCHO STOCK Y POCA SALIDA ============ -->
                    <section class="tab-pane active" t-if="state.tab === 'stock' and showOverstock">
                        <div class="glass-panel padded">
                            <div class="section-header">
                                <div>
                                    <h3>Productos con mucho stock y poca venta</h3>
                                    <p class="section-sub">
                                        <t t-esc="formatNumber(filteredOverstock.length)"/> productos ·
                                        <b><t t-esc="formatCurrency(overFilteredExcess)"/></b> de plata de más
                                        (stock para más de <t t-esc="overstockDays"/> días de venta)
                                    </p>
                                </div>
                                <t t-call="inventory_dashboard_metrics.InfoTip">
                                    <t t-set="tip" t-value="'Sin ventas: hay stock pero no se vendió nada en el período. Sobrestock: se vende, pero el stock alcanza para más de 90 días de venta. De más = stock que sobra por encima de esos 90 días, a costo.'"/>
                                </t>
                            </div>
                            <div class="filter-row">
                                <button class="btn btn-secondary" t-on-click="exportExcel" data-table="overstock">Exportar Excel</button>
                            </div>
                            <div class="table-responsive">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th class="sortable" t-on-click="onSortClick" data-table="over" data-key="producto">Producto<span class="sort-mark" t-esc="sortMark('over', 'producto')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="over" data-key="categoria">Categoría<span class="sort-mark" t-esc="sortMark('over', 'categoria')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="over" data-key="vendor">Proveedor<span class="sort-mark" t-esc="sortMark('over', 'vendor')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="over" data-key="stock">Stock<span class="sort-mark" t-esc="sortMark('over', 'stock')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="over" data-key="sold">Vendidas (<t t-esc="state.period"/> d)<span class="sort-mark" t-esc="sortMark('over', 'sold')"/></th>
                                            <th class="sortable num th-wrap" t-on-click="onSortClick" data-table="over" data-key="daily">Promedio de ventas por día<span class="sort-mark" t-esc="sortMark('over', 'daily')"/></th>
                                            <th class="sortable num th-highlight" t-on-click="onSortClick" data-table="over" data-key="cover">Alcanza para<span class="sort-mark" t-esc="sortMark('over', 'cover')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="over" data-key="status">Estado<span class="sort-mark" t-esc="sortMark('over', 'status')"/></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="overPage.rows.length === 0">
                                            <td colspan="8" class="text-center text-muted empty-row">No hay productos con estos filtros.</td>
                                        </tr>
                                        <t t-foreach="overPage.rows" t-as="r" t-key="r.product_id">
                                            <tr>
                                                <td class="cell-strong cell-text"><t t-esc="r.producto"/></td>
                                                <td class="cell-secondary"><t t-esc="r.categoria"/></td>
                                                <td class="cell-secondary"><t t-esc="r.vendor"/></td>
                                                <td class="num">
                                                    <t t-esc="formatNumber(r.stock)"/>
                                                    <span t-if="r.stock &lt; 0" class="review-tag" title="Stock negativo: falta registrar una entrada de mercadería o un conteo. Para calcular la compra se toma como 0.">revisar</span>
                                                </td>
                                                <td class="num">
                                                    <t t-esc="formatNumber(r.sold)"/>
                                                    <div t-if="r.days &lt; periodDays" class="cell-note muted" title="El producto tiene menos historia que el período: el promedio se calcula sobre estos días.">en <t t-esc="r.days"/> días</div>
                                                </td>
                                                <td class="num"><t t-esc="formatDaily(r.daily)"/></td>
                                                <td class="num">
                                                    <span t-att-class="coverClass(r.cover)">
                                                        <t t-if="r.cover === null">Sin ventas</t>
                                                        <t t-else=""><t t-esc="formatNumber(r.cover)"/> días</t>
                                                    </span>
                                                </td>
                                                <td><span t-att-class="'stock-badge ' + r.status"><t t-esc="r.status === 'sin_venta' ? 'Sin ventas' : 'Sobrestock'"/></span></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="pagination" t-if="overPage.pages &gt; 1">
                                <button class="btn btn-secondary" t-att-disabled="overPage.current &lt;= 1" t-on-click="changePage" data-key="overPage" data-dir="-1">Anterior</button>
                                <span class="page-info">Página <t t-esc="overPage.current"/> de <t t-esc="overPage.pages"/></span>
                                <button class="btn btn-secondary" t-att-disabled="overPage.current &gt;= overPage.pages" t-on-click="changePage" data-key="overPage" data-dir="1">Siguiente</button>
                            </div>
                        </div>
                    </section>
                    <!-- ============ RECOMENDADOR DE COMPRA ============ -->
                    <section class="tab-pane active" t-if="state.tab === 'compra'">
                        <div class="glass-panel padded">
                            <div class="section-header">
                                <div class="buy-summary">
                                    <span class="buy-total-label">Total a comprar</span>
                                    <span class="buy-total"><t t-esc="formatCurrency(buyFilteredTotal)"/></span>
                                    <span class="section-sub">
                                        <t t-esc="formatNumber(filteredPurchase.length)"/> productos ·
                                        <t t-esc="formatNumber(buyFilteredUnits)"/> unidades ·
                                        para <t t-esc="state.buyCover"/> días de venta
                                        <t t-if="buyNoPrice"> · <t t-esc="buyNoPrice"/> sin precio, no suman al total</t>
                                    </span>
                                </div>
                                <t t-call="inventory_dashboard_metrics.InfoTip">
                                    <t t-set="tip" t-value="'Promedio de ventas por día = vendidas / días del período (o los días de historia del producto si tiene menos, mínimo 7). Comprar = promedio x días de la barra Cantidad a comprar - stock, redondeado. Un stock negativo se toma como 0 y se marca con revisar: suele ser una venta sin la entrada de mercadería registrada. Alcanzaría para = días que cubre el stock después de esa compra. Si el proveedor pide un mínimo mayor, se avisa debajo de la cantidad. Urgente: sin stock o alcanza para 15 días o menos. Es una sugerencia: no crea órdenes.'"/>
                                </t>
                            </div>
                            <div class="buy-slider">
                                <div class="buy-slider-head">
                                    <span class="buy-slider-label">Cantidad a comprar</span>
                                    <span class="buy-slider-value"><t t-esc="buyCoverLabel"/> · para <t t-esc="state.buyCover"/> días de venta</span>
                                </div>
                                <input type="range" min="7" max="180" step="1" t-model="state.buyCover" t-on-input="resetBuyPage"/>
                                <div class="buy-slider-scale"><span>Poca</span><span>Mucha</span></div>
                            </div>
                            <div class="filter-row">
                                <button class="btn btn-secondary" t-on-click="exportExcel" data-table="purchase">Exportar Excel</button>
                            </div>
                            <div class="table-responsive">
                                <table class="data-table compact">
                                    <thead>
                                        <tr>
                                            <th class="sortable" t-on-click="onSortClick" data-table="buy" data-key="producto">Producto<span class="sort-mark" t-esc="sortMark('buy', 'producto')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="buy" data-key="vendor">Proveedor<span class="sort-mark" t-esc="sortMark('buy', 'vendor')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="buy" data-key="stock">Stock<span class="sort-mark" t-esc="sortMark('buy', 'stock')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="buy" data-key="sold">Vendidas (<t t-esc="state.period"/> d)<span class="sort-mark" t-esc="sortMark('buy', 'sold')"/></th>
                                            <th class="sortable num th-wrap" t-on-click="onSortClick" data-table="buy" data-key="daily">Promedio de ventas por día<span class="sort-mark" t-esc="sortMark('buy', 'daily')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="buy" data-key="days_after">Alcanzaría para<span class="sort-mark" t-esc="sortMark('buy', 'days_after')"/></th>
                                            <th class="sortable num th-highlight" t-on-click="onSortClick" data-table="buy" data-key="qty">Comprar<span class="sort-mark" t-esc="sortMark('buy', 'qty')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="buy" data-key="price">Precio<span class="sort-mark" t-esc="sortMark('buy', 'price')"/></th>
                                            <th class="sortable num" t-on-click="onSortClick" data-table="buy" data-key="total">Total<span class="sort-mark" t-esc="sortMark('buy', 'total')"/></th>
                                            <th class="sortable" t-on-click="onSortClick" data-table="buy" data-key="status">Prioridad<span class="sort-mark" t-esc="sortMark('buy', 'status')"/></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="state.buyLoading">
                                            <td colspan="10" class="text-center text-muted empty-row">Calculando...</td>
                                        </tr>
                                        <tr t-elif="buyPage.rows.length === 0">
                                            <td colspan="10" class="text-center text-muted empty-row">No hay nada para comprar con estos filtros.</td>
                                        </tr>
                                        <t t-foreach="buyPage.rows" t-as="r" t-key="r.product_id">
                                            <tr>
                                                <td class="cell-strong cell-text"><t t-esc="r.producto"/></td>
                                                <td class="cell-secondary"><t t-esc="r.vendor"/></td>
                                                <td class="num">
                                                    <t t-esc="formatNumber(r.stock)"/>
                                                    <span t-if="r.stock &lt; 0" class="review-tag" title="Stock negativo: falta registrar una entrada de mercadería o un conteo. Para calcular la compra se toma como 0.">revisar</span>
                                                </td>
                                                <td class="num">
                                                    <t t-esc="formatNumber(r.sold)"/>
                                                    <div t-if="r.days &lt; periodDays" class="cell-note muted" title="El producto tiene menos historia que el período: el promedio se calcula sobre estos días.">en <t t-esc="r.days"/> días</div>
                                                </td>
                                                <td class="num"><t t-esc="formatDaily(r.daily)"/></td>
                                                <td class="num"><t t-esc="formatNumber(r.days_after)"/> días</td>
                                                <td class="num">
                                                    <span class="buy-qty"><t t-esc="formatNumber(r.qty)"/></span>
                                                    <div t-if="r.min_qty" class="cell-note">mín. proveedor <t t-esc="formatNumber(r.min_qty)"/></div>
                                                </td>
                                                <td class="num">
                                                    <t t-if="r.price"><t t-esc="formatCurrency(r.price)"/></t>
                                                    <t t-else=""><span class="text-muted">Sin precio</span></t>
                                                </td>
                                                <td class="num cell-strong"><t t-esc="formatCurrency(r.total)"/></td>
                                                <td><span t-att-class="'stock-badge ' + (r.status === 'urgente' ? 'rotura' : 'critico')"><t t-esc="r.status === 'urgente' ? 'Urgente' : 'Normal'"/></span></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="pagination" t-if="buyPage.pages &gt; 1">
                                <button class="btn btn-secondary" t-att-disabled="buyPage.current &lt;= 1" t-on-click="changePage" data-key="buyPage" data-dir="-1">Anterior</button>
                                <span class="page-info">Página <t t-esc="buyPage.current"/> de <t t-esc="buyPage.pages"/></span>
                                <button class="btn btn-secondary" t-att-disabled="buyPage.current &gt;= buyPage.pages" t-on-click="changePage" data-key="buyPage" data-dir="1">Siguiente</button>
                            </div>
                        </div>
                    </section>
                </div>
            </main>
        </div>
    </t>
</templates>
