<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_lock_defaults" model="ir.ui.view">
        <field name="name">product.template.form.lock.defaults</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Campo auxiliar: indica si el usuario puede editar los campos bloqueados -->
            <field name="sale_ok" position="before">
                <field name="can_edit_product_defaults" invisible="1"/>
                <field name="show_page_variants" invisible="1"/>
                <field name="show_page_sales" invisible="1"/>
                <field name="show_page_purchase" invisible="1"/>
                <field name="show_page_inventory" invisible="1"/>
                <field name="show_page_pos" invisible="1"/>
            </field>

            <field name="type" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="is_storable" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="invoice_policy" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="sale_ok" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="purchase_ok" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="available_in_pos" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>

            <!-- Ocultar pestañas segun el grupo del usuario. `add` con separator
                 "or" suma nuestra condicion a la nativa en vez de reemplazarla. -->
            <xpath expr="//page[@name='sales']" position="attributes">
                <attribute name="invisible" add="not show_page_sales" separator="or"/>
            </xpath>
            <xpath expr="//page[@name='purchase']" position="attributes">
                <attribute name="invisible" add="not show_page_purchase" separator="or"/>
            </xpath>
            <xpath expr="//page[@name='inventory']" position="attributes">
                <attribute name="invisible" add="not show_page_inventory" separator="or"/>
            </xpath>
            <xpath expr="//page[@name='pos']" position="attributes">
                <attribute name="invisible" add="not show_page_pos" separator="or"/>
            </xpath>

        </field>
    </record>

    <!-- La pestaña "Atributos y variantes" no vive en product_template_form_view
         sino en la vista primary que la hereda, asi que necesita su propio record. -->
    <record id="product_template_only_form_hide_variants" model="ir.ui.view">
        <field name="name">product.template.only.form.hide.variants</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']" position="attributes">
                <attribute name="invisible" add="not show_page_variants" separator="or"/>
            </xpath>
        </field>
    </record>
</odoo>
