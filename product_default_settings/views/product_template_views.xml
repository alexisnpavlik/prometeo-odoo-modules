<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_lock_defaults" model="ir.ui.view">
        <field name="name">product.template.form.lock.defaults</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Campo auxiliar: indica si el usuario puede editar los campos bloqueados -->
            <field name="sale_ok" position="before">
                <field name="can_edit_product_defaults" invisible="1"/>
            </field>

            <field name="type" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="is_storable" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="invoice_policy" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="sale_ok" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="purchase_ok" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>
            <field name="available_in_pos" position="attributes">
                <attribute name="readonly">not can_edit_product_defaults</attribute>
            </field>

        </field>
    </record>
</odoo>
