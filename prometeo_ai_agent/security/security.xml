<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_agent" model="ir.module.category">
        <field name="name">Agente IA</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Usuario del agente</field>
        <field name="category_id" ref="module_category_ai_agent"/>
        <field name="comment">Ve sus alertas, usa el chat y ve las rutinas visibles para él.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Administrador del agente</field>
        <field name="category_id" ref="module_category_ai_agent"/>
        <field name="comment">Crea rutinas, configura proveedores, modelos y límites, ve consumo y todas las alertas.</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_ai_alert_user" model="ir.rule">
        <field name="name">Alertas: solo las propias</field>
        <field name="model_id" ref="model_prometeo_ai_alert"/>
        <field name="domain_force">[('recipient_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="rule_ai_alert_admin" model="ir.rule">
        <field name="name">Alertas: todas (administrador)</field>
        <field name="model_id" ref="model_prometeo_ai_alert"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_admin'))]"/>
    </record>

    <record id="rule_ai_routine_user" model="ir.rule">
        <field name="name">Rutinas: públicas, de mis grupos o que me llegan</field>
        <field name="model_id" ref="model_prometeo_ai_routine"/>
        <field name="domain_force">['|', '|', ('is_public', '=', True), ('group_ids', 'in', user.groups_id.ids), ('recipient_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="rule_ai_routine_admin" model="ir.rule">
        <field name="name">Rutinas: todas (administrador)</field>
        <field name="model_id" ref="model_prometeo_ai_routine"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_admin'))]"/>
    </record>

    <!-- Chats privados: una sola regla, sin bypass para administradores (las reglas de grupo se suman con OR). -->
    <record id="rule_ai_conversation_own" model="ir.rule">
        <field name="name">Conversaciones: solo las propias</field>
        <field name="model_id" ref="model_prometeo_ai_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="rule_ai_message_own" model="ir.rule">
        <field name="name">Mensajes de chat: solo los propios</field>
        <field name="model_id" ref="model_prometeo_ai_message"/>
        <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
</odoo>
