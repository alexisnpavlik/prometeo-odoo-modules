<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_run_list" model="ir.ui.view">
        <field name="name">prometeo.ai.run.list</field>
        <field name="model">prometeo.ai.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Fecha"/>
                <field name="kind"/>
                <field name="routine_id"/>
                <field name="user_id" optional="hide"/>
                <field name="ai_model_id"/>
                <field name="input_tokens" sum="Total"/>
                <field name="output_tokens" sum="Total"/>
                <field name="tool_calls" optional="hide"/>
                <field name="duration" optional="hide"/>
                <field name="cost" sum="Total"/>
                <field name="price_known" optional="hide"/>
                <field name="status" decoration-danger="status == 'error'" decoration-warning="status in ('incomplete', 'skipped_cap')"/>
                <field name="error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_run_pivot" model="ir.ui.view">
        <field name="name">prometeo.ai.run.pivot</field>
        <field name="model">prometeo.ai.run</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="routine_id" type="row"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ai_run_search" model="ir.ui.view">
        <field name="name">prometeo.ai.run.search</field>
        <field name="model">prometeo.ai.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="routine_id"/>
                <field name="ai_model_id"/>
                <filter name="this_month" string="Este mes" date="create_date" default_period="month"/>
                <filter name="errors" string="Con error" domain="[('status', '=', 'error')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_routine" string="Rutina" context="{'group_by': 'routine_id'}"/>
                    <filter name="group_model" string="Modelo" context="{'group_by': 'ai_model_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_run" model="ir.actions.act_window">
        <field name="name">Corridas</field>
        <field name="res_model">prometeo.ai.run</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>
</odoo>
