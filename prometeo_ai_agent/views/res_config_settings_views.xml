<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_agent" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.prometeo_ai_agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Agente IA" string="Agente IA" name="prometeo_ai_agent"
                     groups="prometeo_ai_agent.group_admin">
                    <block title="Proveedores" name="ai_providers_block">
                        <setting string="Claude (Anthropic)" help="Clave de API de console.anthropic.com.">
                            <field name="ai_anthropic_key" password="True" placeholder="sk-ant-..."/>
                            <div class="mt8 small">
                                <field name="ai_anthropic_ok" invisible="1"/>
                                <span invisible="not ai_anthropic_ok" class="text-success"><i class="fa fa-check-circle me-1"/></span>
                                <span invisible="ai_anthropic_ok" class="text-warning"><i class="fa fa-exclamation-circle me-1"/></span>
                                <field name="ai_anthropic_status" class="d-inline" readonly="1"/>
                            </div>
                            <button name="action_ai_fetch_models_anthropic" type="object" string="Actualizar modelos" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                        <setting string="OpenAI o compatible" help="Cambiando la URL sirve para cualquier API compatible con OpenAI.">
                            <field name="ai_openai_key" password="True" placeholder="sk-..."/>
                            <div class="mt8 small">
                                <field name="ai_openai_ok" invisible="1"/>
                                <span invisible="not ai_openai_ok" class="text-success"><i class="fa fa-check-circle me-1"/></span>
                                <span invisible="ai_openai_ok" class="text-warning"><i class="fa fa-exclamation-circle me-1"/></span>
                                <field name="ai_openai_status" class="d-inline" readonly="1"/>
                            </div>
                            <div class="content-group mt8"><label for="ai_openai_base_url" string="URL" class="me-2"/><field name="ai_openai_base_url"/></div>
                            <button name="action_ai_fetch_models_openai" type="object" string="Actualizar modelos" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                        <setting string="Google Gemini" help="Clave de API de aistudio.google.com.">
                            <field name="ai_google_key" password="True" placeholder="AIza..."/>
                            <div class="mt8 small">
                                <field name="ai_google_ok" invisible="1"/>
                                <span invisible="not ai_google_ok" class="text-success"><i class="fa fa-check-circle me-1"/></span>
                                <span invisible="ai_google_ok" class="text-warning"><i class="fa fa-exclamation-circle me-1"/></span>
                                <field name="ai_google_status" class="d-inline" readonly="1"/>
                            </div>
                            <button name="action_ai_fetch_models_google" type="object" string="Actualizar modelos" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                    </block>
                    <block title="Modelo por defecto" name="ai_model_block">
                        <setting string="Modelo por defecto" help="Se usa en el chat y en las rutinas sin modelo propio.">
                            <field name="ai_default_model_id" options="{'no_create': True}"/>
                            <div class="text-muted mt8"><field name="ai_active_model_count" class="d-inline"/> modelos activos.
                                Los modelos nuevos entran inactivos: activalos y revisá su precio.</div>
                            <button name="action_ai_open_models" type="object" string="Activar modelos y precios" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                    </block>
                    <block title="Límites" name="ai_limits_block">
                        <setting string="Consultas" help="Máximo de registros por consulta y tamaño del resultado que recibe el modelo.">
                            <div class="content-group">
                                <div class="row mt8"><label for="ai_max_records" class="col-lg-6"/><field name="ai_max_records"/></div>
                                <div class="row"><label for="ai_max_result_chars" class="col-lg-6"/><field name="ai_max_result_chars"/></div>
                            </div>
                        </setting>
                        <setting string="Chat" help="Cada turno ocupa un proceso del servidor mientras espera al proveedor.">
                            <div class="content-group">
                                <div class="row mt8"><label for="ai_chat_max_tool_calls" class="col-lg-6"/><field name="ai_chat_max_tool_calls"/></div>
                                <div class="row"><label for="ai_chat_max_seconds" class="col-lg-6"/><field name="ai_chat_max_seconds"/></div>
                                <div class="row"><label for="ai_chat_max_concurrent" class="col-lg-6"/><field name="ai_chat_max_concurrent"/></div>
                            </div>
                        </setting>
                        <setting string="Rutinas" help="Al llegar al límite la corrida queda incompleta y conserva sus alertas.">
                            <div class="content-group">
                                <div class="row mt8"><label for="ai_routine_max_tool_calls" class="col-lg-6"/><field name="ai_routine_max_tool_calls"/></div>
                                <div class="row"><label for="ai_routine_max_seconds" class="col-lg-6"/><field name="ai_routine_max_seconds"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Tope de gasto" name="ai_cap_block">
                        <setting string="Tope mensual (USD)" help="0 = sin tope. Al alcanzarlo se pausan rutinas y chat hasta el mes siguiente.">
                            <field name="ai_monthly_cap_usd"/>
                        </setting>
                    </block>
                    <block title="Alertas" name="ai_alerts_block">
                        <setting string="Resumen diario" help="Hora local en que se envía el resumen de las últimas 24 horas.">
                            <field name="ai_digest_hour"/>
                        </setting>
                        <setting string="Contacto de soporte" help="Se muestra a los usuarios cuando el servicio de IA falla (sin crédito, clave vencida).">
                            <field name="ai_support_contact" placeholder="Ej.: Alexis, 11 5555-5555"/>
                        </setting>
                        <setting string="Silencio al descartar" help="Días en que una alerta descartada no se vuelve a crear.">
                            <field name="ai_dismiss_silence_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ai_settings" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'prometeo_ai_agent', 'bin_size': False}</field>
    </record>
</odoo>
