<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_auto_update_cost" model="ir.ui.view">
        <field name="name">purchase.order.form.auto.update.cost</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Aviso de precios que cambian al confirmar (solo en borrador) -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="edit_sale_price" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not price_update_warning">
                    <field name="price_update_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>

            <!-- Renombra "Precio unitario" -> "Precio de costo" y ensancha para que no se corte -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="string">Precio de costo</attribute>
                <attribute name="width">130px</attribute>
            </xpath>

            <!-- Nuevo campo "Precio de venta" en la lista, tras el precio de costo -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="price_sale" width="130px" readonly="qty_invoiced != 0" column_invisible="not parent.edit_sale_price"/>
            </xpath>

            <!-- Mismo cambio en el formulario de la línea -->
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="string">Precio de costo</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="price_sale" invisible="not parent.edit_sale_price"/>
            </xpath>

        </field>
    </record>

</odoo>
