<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout" name="Prometeo ERP: pie de emails">
        <xpath expr="//a[contains(@href, 'www.odoo.com')]" position="replace">
            <a target="_blank" href="https://prometeo.com.ar/"
               t-att-style="'color: ' + (company.email_secondary_color or '#F76707') + ';'">Prometeo ERP</a>
        </xpath>
    </template>

    <template id="mail_notification_light" inherit_id="mail.mail_notification_light" name="Prometeo ERP: pie de emails livianos">
        <xpath expr="//a[contains(@href, 'www.odoo.com')]" position="replace">
            <a target="_blank" href="https://prometeo.com.ar/"
               t-att-style="'color: ' + (company.email_secondary_color or '#F76707') + ';'">Prometeo ERP</a>
        </xpath>
    </template>
</odoo>
