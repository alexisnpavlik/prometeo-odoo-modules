<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Ajustes > bloque de versión al pie -->
    <t t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//h3" position="replace">
            <h3 class="px-0">Prometeo ERP <t t-esc="serverVersion"/></h3>
        </xpath>
        <xpath expr="//small" position="replace">
            <small>
                <a target="_blank" href="https://prometeo.com.ar/" style="text-decoration: underline;">prometeo.com.ar</a>
                <span class="mx-2">|</span>
                <a id="license" target="_blank" href="http://www.gnu.org/licenses/lgpl.html" style="text-decoration: underline;">Licencia GNU LGPL</a>
            </small>
        </xpath>
    </t>
</templates>
