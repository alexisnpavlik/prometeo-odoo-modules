<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Logo "Powered by" de la pantalla del cliente; monochrome va sobre fondo oscuro -->
    <t t-inherit="point_of_sale.OdooLogo" t-inherit-mode="extension">
        <xpath expr="//div" position="replace">
            <div t-attf-class="{{ props.class }}" t-attf-style="{{ props.style }}">
                <img class="img-fluid" alt="Prometeo ERP"
                     t-att-src="props.monochrome ? '/prometeo_branding/static/src/img/prometeo_logo_horizontal_light.svg' : '/prometeo_branding/static/src/img/prometeo_logo_horizontal.svg'"/>
            </div>
        </xpath>
    </t>
</templates>
