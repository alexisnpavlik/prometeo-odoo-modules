<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- La caja muestra solo sus productos: la barra de Categorías de PdV no se usa. -->
    <t t-name="pos_category_filter.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//CategorySelector" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
</templates>
