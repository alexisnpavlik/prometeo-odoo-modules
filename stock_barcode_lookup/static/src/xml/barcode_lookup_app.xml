<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_barcode_lookup.App">
        <div class="o_barcode_lookup o_action">
            <div class="o_barcode_lookup_body">
                <button class="o_barcode_lookup_scan btn btn-primary" t-on-click="onScan" t-att-disabled="state.loading">
                    <i class="fa fa-barcode"/>
                    <span>Escanear</span>
                </button>
                <input type="file" accept="image/*" capture="environment" class="d-none"
                       t-ref="photoInput" t-on-change="onPhoto"/>
                <input type="file" accept="image/*" capture="environment" class="d-none"
                       t-ref="productPhotoInput" t-on-change="onProductPhoto"/>

                <form class="o_barcode_lookup_manual" t-on-submit="onManualSubmit">
                    <input type="search" class="form-control" enterkeyhint="search"
                           placeholder="O buscá por nombre o código"
                           t-att-value="state.code" t-on-input="onSearchInput"/>
                    <button type="submit" class="btn btn-secondary"><i class="fa fa-search"/></button>
                </form>

                <div t-if="state.loading" class="o_barcode_lookup_loading">
                    <i class="fa fa-spinner fa-spin"/> Buscando...
                </div>

                <div t-elif="state.results.length" class="o_barcode_lookup_results list-group">
                    <button t-foreach="state.results" t-as="item" t-key="item.product_id"
                            class="list-group-item list-group-item-action" t-on-click="() => this.selectProduct(item.product_id)">
                        <img t-att-src="item.image_url" alt=""/>
                        <div class="o_barcode_lookup_results_info">
                            <div class="fw-bold" t-esc="item.name"/>
                            <div t-if="item.code" class="text-muted small" t-esc="item.code"/>
                        </div>
                        <div class="o_barcode_lookup_results_price" t-esc="item.price"/>
                    </button>
                </div>

                <t t-elif="state.result">
                    <div t-if="state.result.found" class="o_barcode_lookup_card">
                        <img t-att-src="state.result.image_url" alt=""/>
                        <div class="o_barcode_lookup_info">
                            <h2 t-esc="state.result.name"/>
                            <div class="o_barcode_lookup_price" t-esc="state.result.price"/>
                            <div>Stock: <strong t-esc="state.result.qty_available"/> <t t-esc="state.result.uom"/></div>
                            <div t-if="state.result.vendor">Proveedor: <t t-esc="state.result.vendor"/></div>
                            <div class="text-muted">Código: <t t-esc="state.result.code"/></div>
                        </div>
                        <div class="o_barcode_lookup_actions o_barcode_lookup_actions_grid">
                            <button class="btn btn-primary o_wide" t-on-click="openProduct">
                                <i class="fa fa-external-link"/> Abrir ficha
                            </button>
                            <button t-if="state.result.can_replenish" class="btn btn-secondary" t-on-click="replenish">
                                <i class="fa fa-refresh"/> Reabastecer
                            </button>
                            <button t-attf-class="btn btn-secondary {{ state.result.can_replenish ? '' : 'o_wide' }}"
                                    t-on-click="onTakeProductPhoto">
                                <i class="fa fa-camera"/> Sacar foto
                            </button>
                            <button class="btn btn-outline-secondary o_wide" t-on-click="reset">
                                <i class="fa fa-barcode"/> Escanear otro
                            </button>
                        </div>
                    </div>
                    <div t-else="" class="o_barcode_lookup_card o_barcode_lookup_missing">
                        <h2 t-if="state.result.is_code">No hay ningún producto con el código <t t-esc="state.result.code"/></h2>
                        <h2 t-else="">No hay productos que coincidan con «<t t-esc="state.result.code"/>»</h2>
                        <div class="o_barcode_lookup_actions">
                            <button class="btn btn-primary" t-on-click="createProduct">
                                <t t-if="state.result.is_code">Crear producto con este código</t>
                                <t t-else="">Crear producto con este nombre</t>
                            </button>
                            <button class="btn btn-outline-secondary" t-on-click="reset">Escanear otro</button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
