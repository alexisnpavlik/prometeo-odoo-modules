<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- El botón va fuera de o_field_input_buttons: Odoo oculta ese contenedor
         hasta el hover, que en el teléfono no existe. -->
    <t t-name="product_barcode_camera.BarcodeCameraField" t-inherit="web.CharField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_field_input_buttons')]" position="after">
            <button t-if="showCamera"
                type="button"
                class="btn btn-secondary o_barcode_camera_button"
                title="Escanear con la cámara"
                aria-label="Escanear con la cámara"
                t-on-click="onCameraClick">
                <i class="fa fa-camera"/>
            </button>
        </xpath>
    </t>
</templates>
