<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_promotion_badge.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]/t[@t-slot='product-name']" position="after">
            <span t-if="line.promotion and !props.basic_receipt" class="o_promotion_badge badge rounded-pill ms-1">
                <i class="fa fa-tag me-1" role="img" aria-label="Promoción"/>Promoción
            </span>
        </xpath>
    </t>
</templates>
