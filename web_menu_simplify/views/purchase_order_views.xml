<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_confirm_receive" model="ir.ui.view">
        <field name="name">purchase.order.form.confirm.receive</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="simplify_confirm_receive" invisible="1"/>
                <button name="action_simplify_confirm_receive"
                        type="object"
                        string="Confirmar e ingresar"
                        class="btn-primary"
                        data-hotkey="v"
                        invisible="not simplify_confirm_receive or state not in ('draft', 'sent')"/>
                <field name="simplify_print" invisible="1"/>
                <button name="%(purchase.action_report_purchase_order)d"
                        type="action"
                        string="Imprimir"
                        icon="fa-print"
                        invisible="not simplify_print or state not in ('purchase', 'done')"/>
                <field name="simplify_can_return" invisible="1"/>
                <button name="action_simplify_return"
                        type="object"
                        string="Devolver"
                        icon="fa-undo"
                        invisible="not simplify_can_return"/>
            </xpath>
            <!-- En el teléfono Odoo manda los botones del encabezado al menú del engranaje:
                 esta barra los deja a la vista. En pantallas medianas y grandes no se muestra. -->
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="o_simplify_mobile_actions d-md-none">
                    <button name="action_simplify_confirm_receive"
                            type="object"
                            string="Confirmar e ingresar"
                            class="btn btn-primary"
                            invisible="not simplify_confirm_receive or state not in ('draft', 'sent')"/>
                    <button name="%(purchase.action_report_purchase_order)d"
                            type="action"
                            string="Imprimir"
                            icon="fa-print"
                            class="btn btn-secondary"
                            invisible="not simplify_print or state not in ('purchase', 'done')"/>
                    <button name="action_simplify_return"
                            type="object"
                            string="Devolver"
                            icon="fa-undo"
                            class="btn btn-secondary"
                            invisible="not simplify_can_return"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
