<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_suggestion_list" model="ir.ui.view">
        <field name="name">prometeo.purchase.suggestion.list</field>
        <field name="model">prometeo.purchase.suggestion</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="supply_mode" optional="show"/>
                <field name="demand_warehouse_ids" widget="many2many_tags" optional="hide"/>
                <field name="category_ids" widget="many2many_tags" optional="hide"/>
                <field name="date_computed"/>
                <field name="user_id" optional="show"/>
                <field name="line_count" string="Líneas"/>
                <field name="low_confidence_count" string="Baja confianza" optional="hide"/>
                <field name="edit_rate" string="Editadas" widget="percentage" optional="hide"/>
                <field name="total_amount" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'computed'"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_suggestion_form" model="ir.ui.view">
        <field name="name">prometeo.purchase.suggestion.form</field>
        <field name="model">prometeo.purchase.suggestion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Calcular"
                            class="oe_highlight" invisible="state not in ('draft', 'computed')"/>
                    <button name="action_confirm" type="object" string="Confirmar"
                            class="oe_highlight" invisible="state != 'computed'"/>
                    <button name="action_create_purchase_orders" type="object"
                            string="Crear órdenes de compra" class="oe_highlight"
                            invisible="state != 'confirmed'"
                            confirm="Se van a crear órdenes de compra en borrador agrupadas por proveedor. ¿Seguimos?"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state not in ('computed', 'confirmed', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo"
                                   string="Órdenes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="low_confidence_count == 0 or state == 'draft'">
                        <field name="low_confidence_count" class="oe_inline"/>
                        línea(s) tienen baja confianza estadística. Revisalas antes de confirmar.
                    </div>
                    <group>
                        <group>
                            <field name="supply_mode" widget="radio" readonly="state != 'draft'"/>
                            <field name="warehouse_id" string="Almacén de recepción"
                                   options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="demand_warehouse_ids" widget="many2many_tags"
                                   domain="[('id', '!=', warehouse_id)]"
                                   options="{'no_create': True}"
                                   invisible="supply_mode != 'centralized'" readonly="state != 'draft'"/>
                            <button name="action_detect_demand_warehouses" type="object"
                                    string="Sugerir sucursales según movimientos"
                                    invisible="supply_mode != 'centralized' or state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="coverage_days" readonly="state not in ('draft', 'computed')"/>
                            <field name="transfer_days" invisible="supply_mode != 'centralized'"
                                   readonly="state not in ('draft', 'computed')"/>
                            <field name="demand_model_id" readonly="state not in ('draft', 'computed')"/>
                            <field name="date_computed"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="supply_mode != 'centralized'">
                        Se suman las necesidades de las sucursales seleccionadas y del almacén de recepción.
                        Se genera una orden por proveedor, recibida en ese almacén.
                        El reparto posterior a las sucursales se gestiona por separado.
                    </div>
                    <group string="Productos a comprar">
                        <field name="category_ids" widget="many2many_tags"
                               placeholder="Todas las categorías" options="{'no_create': True}"
                               readonly="state != 'draft'"/>
                        <field name="include_subcategories" invisible="not category_ids"
                               readonly="state != 'draft'"/>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not calculation_notes">
                        <field name="calculation_notes" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Líneas" name="lines">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom" open_form_view="True"
                                      decoration-danger="coverage_days_current &lt; lead_time_days and qty_final &gt; 0"
                                      decoration-warning="confidence &lt; 0.5 and confidence &gt; 0"
                                      decoration-info="is_manual"
                                      decoration-muted="qty_final == 0">
                                    <field name="product_id"
                                           domain="[('categ_id', 'child_of' if parent.include_subcategories else 'in', parent.category_ids)] if parent.category_ids else []"/>
                                    <field name="coverage_days_current" string="Cobertura" readonly="1"/>
                                    <field name="qty_on_hand" string="Stock" readonly="1"/>
                                    <field name="qty_incoming" string="Tránsito" readonly="1"/>
                                    <field name="adu" string="Venta/día" readonly="1"/>
                                    <field name="qty_suggested" string="Sugerido" readonly="1"/>
                                    <field name="qty_final" string="Cantidad"/>
                                    <field name="supplier_id"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total" readonly="1"/>
                                    <field name="sigma" optional="hide" readonly="1"/>
                                    <field name="safety_stock" optional="hide" readonly="1"/>
                                    <field name="lead_time_days" optional="hide" readonly="1"/>
                                    <field name="abc_class" optional="hide" readonly="1"/>
                                    <field name="xyz_class" optional="hide" readonly="1"/>
                                    <field name="confidence" optional="hide" readonly="1"/>
                                    <field name="method_used" optional="hide" readonly="1"/>
                                    <field name="explanation" widget="text" optional="hide" readonly="1"/>
                                    <field name="warnings" widget="text" optional="hide" readonly="1"/>
                                    <field name="is_manual" column_invisible="True"/>
                                    <field name="was_edited" optional="hide" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount"/>
                            </group>
                        </page>
                        <page string="Calidad del cálculo" name="quality"
                              invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="line_count"/>
                                    <field name="low_confidence_count"/>
                                </group>
                                <group>
                                    <field name="edit_rate" widget="percentage"/>
                                    <field name="mean_deviation"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                <p>Una tasa de edición por encima del 50% significa que el
                                   modelo está mal calibrado para este negocio: conviene
                                   revisar los días de cobertura y el nivel de servicio.</p>
                                <p>Un desvío medio sistemáticamente positivo significa que
                                   el modelo sugiere de menos.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_purchase_suggestion_line_form" model="ir.ui.view">
        <field name="name">prometeo.purchase.suggestion.line.form</field>
        <field name="model">prometeo.purchase.suggestion.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" readonly="1" options="{'no_open': True}"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="confidence >= 0.5 or confidence == 0">
                        La estimación de esta línea tiene poca base estadística.
                        Conviene decidir la cantidad a mano.
                    </div>
                    <group string="Por qué esta cantidad">
                        <field name="explanation" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group string="Advertencias" invisible="not warnings">
                        <field name="warnings" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group>
                        <group string="Qué se compra">
                            <field name="qty_suggested"/>
                            <field name="qty_final"/>
                            <field name="supplier_id"/>
                            <field name="price_unit"/>
                            <field name="subtotal"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Situación actual">
                            <field name="qty_on_hand"/>
                            <field name="qty_incoming"/>
                            <field name="coverage_days_current"/>
                            <field name="lead_time_days"/>
                        </group>
                        <group string="Demanda estimada">
                            <field name="adu"/>
                            <field name="sigma"/>
                            <field name="safety_stock"/>
                            <field name="confidence"/>
                        </group>
                        <group string="Cómo se calculó">
                            <field name="demand_model_id"/>
                            <field name="method_used"/>
                            <field name="abc_class"/>
                            <field name="xyz_class"/>
                            <field name="is_manual"/>
                            <field name="was_edited"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_suggestion_search" model="ir.ui.view">
        <field name="name">prometeo.purchase.suggestion.search</field>
        <field name="model">prometeo.purchase.suggestion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <filter name="my_suggestions" string="Mis sugerencias"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="state_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="state_computed" string="Calculadas" domain="[('state', '=', 'computed')]"/>
                <filter name="state_confirmed" string="Confirmadas" domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_done" string="Con órdenes" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="not_cancelled" string="Sin canceladas" domain="[('state', '!=', 'cancel')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Responsable" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_suggestion" model="ir.actions.act_window">
        <field name="name">Sugerencias de compra</field>
        <field name="res_model">prometeo.purchase.suggestion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creá tu primera sugerencia de compra</p>
            <p>Elegí un almacén, calculá, revisá las cantidades y generá las órdenes agrupadas por proveedor.</p>
        </field>
    </record>

    <record id="action_purchase_suggestion_centralized" model="ir.actions.act_window">
        <field name="name">Compra para varias sucursales</field>
        <field name="res_model">prometeo.purchase.suggestion</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('supply_mode', '=', 'centralized')]</field>
        <field name="context">{'default_supply_mode': 'centralized', 'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Prepará una compra conjunta para tus sucursales</p>
            <p>Elegí dónde recibir, las sucursales a abastecer y las categorías que querés comprar.
               Calculá y revisá las cantidades para generar una orden por proveedor.</p>
        </field>
    </record>
</odoo>
