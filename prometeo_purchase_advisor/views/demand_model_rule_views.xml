<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demand_model_rule_list" model="ir.ui.view">
        <field name="name">prometeo.demand.model.rule.list</field>
        <field name="model">prometeo.demand.model.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="abc_class"/>
                <field name="xyz_class"/>
                <field name="min_history_days"/>
                <field name="domain" widget="domain" options="{'model': 'product.product'}"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_demand_model_rule" model="ir.actions.act_window">
        <field name="name">Reglas de asignación</field>
        <field name="res_model">prometeo.demand.model.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Asigná modelos de demanda por regla</p>
            <p>Se evalúan en orden: la primera regla que matchea el producto gana. Si ninguna matchea se usa el modelo por defecto de la compañía.</p>
        </field>
    </record>
</odoo>
