<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_pricelist_lines" model="ir.ui.view">
        <field name="name">product.template.form.pricelist.lines</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="internal_notes" position="before">
                <group name="pricelist_lines" string="Listas de precios"
                       groups="product.group_product_pricelist">
                    <field name="pricelist_line_ids" nolabel="1" colspan="2"
                           context="{'allowed_company_ids': False}">
                        <list editable="bottom">
                            <field name="pricelist_id" widget="pricelist_many2one_all"
                                   options="{'no_create': True}"
                                   context="{'allowed_company_ids': False}"
                                   domain="[('name', '!=', 'Predeterminado')]"/>
                            <field name="fixed_price" string="Precio"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="date_start" optional="show"/>
                            <field name="date_end" optional="show"/>
                            <field name="company_id" optional="show"
                                   groups="base.group_multi_company"/>
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
