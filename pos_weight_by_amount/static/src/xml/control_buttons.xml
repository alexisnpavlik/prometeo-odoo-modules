<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_weight_by_amount.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <!-- Mismo lugar que el botón de nota: pantalla principal en escritorio, popup de Acciones en celular -->
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="!props.showRemainingButtons || (ui.isSmall and props.showRemainingButtons)"
                class="o_weight_by_amount_button"
                t-att-class="buttonClass"
                t-att-disabled="!weightByAmountLine"
                title="Ingresar el importe y calcular la cantidad"
                t-on-click="() => this.clickWeightByAmount()">
                <i class="fa fa-balance-scale me-1"/>$ → kg
            </button>
        </xpath>
    </t>
</templates>
