<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Una tecla con subButton se parte en dos dentro de la misma celda: la tecla arriba y el subButton abajo -->
    <t t-name="pos_weight_by_amount.Numpad" t-inherit="point_of_sale.Numpad" t-inherit-mode="extension">
        <xpath expr="//t[@t-as='button']/button" position="before">
            <div t-elif="button.subButton"
                t-attf-class="numpad-button numpad-split d-flex flex-column m-1 p-0 {{ button.class or '' }}">
                <button
                    t-attf-class="btn btn-light btn-lg fs-3 flex-grow-1 rounded-0 rounded-top m-0 py-0 {{ button.class or '' }}"
                    t-att-value="button.text or button.value"
                    t-on-click="() => this.onClick(button.value)"
                    t-att-disabled="button.disabled"
                    t-esc="button.text or button.value"/>
                <button
                    class="o_weight_by_amount_button btn btn-light fs-6 rounded-0 rounded-bottom m-0 py-1 border-top"
                    t-att-title="button.subButton.title"
                    t-on-click="() => this.onClick(button.subButton.value)"
                    t-att-disabled="button.subButton.disabled">
                    <i class="fa fa-balance-scale me-1"/><t t-esc="button.subButton.text"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
