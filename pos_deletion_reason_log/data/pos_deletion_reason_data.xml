<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: se siembran una sola vez. Así el usuario puede editar/renombrar
         o agregar motivos sin que un -u los pise, y el upgrade no reescribe estas
         filas (evita conflictos de escritura concurrente con el POS en vivo). -->
    <data noupdate="1">
    <record id="reason_error_carga" model="pos.deletion.reason">
        <field name="name">Error de carga</field>
        <field name="sequence">10</field>
    </record>
    <record id="reason_cliente_arrepentido" model="pos.deletion.reason">
        <field name="name">Cliente se arrepintió</field>
        <field name="sequence">20</field>
    </record>
    <record id="reason_duplicado" model="pos.deletion.reason">
        <field name="name">Duplicado</field>
        <field name="sequence">30</field>
    </record>
    <record id="reason_articulo_roto" model="pos.deletion.reason">
        <field name="name">Artículo roto</field>
        <field name="sequence">40</field>
    </record>
    <record id="reason_autorizacion_gerencia" model="pos.deletion.reason">
        <field name="name">Autorización de gerencia</field>
        <field name="sequence">50</field>
    </record>
    </data>
</odoo>
