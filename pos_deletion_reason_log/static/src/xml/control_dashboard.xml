<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_deletion_reason_log.ControlDashboard">
        <div t-att-class="'pos-dashboard-wrap ' + (state.theme === 'light' ? 'theme-light' : '')">
            <!-- Sidebar de Filtros (Glassmorphic) -->
            <aside class="sidebar">
                <div class="sidebar-brand">
                    <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"></path>
                        <path d="M9 12l2 2 4-4"></path>
                    </svg>
                    <div class="brand-text">
                        <h2>Métricas de Cajeros</h2>
                        <span>Trazabilidad POS</span>
                    </div>
                </div>

                <!-- Rango de Fechas Predefinido -->
                <div class="sidebar-section">
                    <h3>Rango de Fecha</h3>
                    <div class="preset-dates">
                        <button t-att-class="'btn-preset ' + (state.preset === 'today' ? 'active' : '')" t-on-click="() => this.onPreset('today')">Hoy</button>
                        <button t-att-class="'btn-preset ' + (state.preset === 'yesterday' ? 'active' : '')" t-on-click="() => this.onPreset('yesterday')">Ayer</button>
                        <button t-att-class="'btn-preset ' + (state.preset === '7days' ? 'active' : '')" t-on-click="() => this.onPreset('7days')">7 días</button>
                        <button t-att-class="'btn-preset ' + (state.preset === '30days' ? 'active' : '')" t-on-click="() => this.onPreset('30days')">30 días</button>
                        <button t-att-class="'btn-preset ' + (state.preset === '90days' ? 'active' : '')" t-on-click="() => this.onPreset('90days')">90 días</button>
                        <button t-att-class="'btn-preset ' + (state.preset === 'all' ? 'active' : '')" t-on-click="() => this.onPreset('all')">Todo</button>
                    </div>
                    <div class="custom-date-inputs">
                        <div class="input-group">
                            <label>Desde</label>
                            <input type="date" t-att-value="state.startDate" t-on-change="onStartDate"/>
                        </div>
                        <div class="input-group">
                            <label>Hasta</label>
                            <input type="date" t-att-value="state.endDate" t-on-change="onEndDate"/>
                        </div>
                    </div>
                </div>

                <!-- Filtros -->
                <div class="sidebar-section">
                    <h3>Filtros</h3>
                    <div class="input-group">
                        <label>Caja</label>
                        <div class="select-wrapper">
                            <select t-model="state.pos">
                                <option value="all">Todas</option>
                                <t t-foreach="filtersData.cajas" t-as="c" t-key="c"><option t-att-value="c"><t t-esc="c"/></option></t>
                            </select>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Cajero</label>
                        <div class="select-wrapper">
                            <select t-model="state.cashier">
                                <option value="all">Todos</option>
                                <t t-foreach="filtersData.cajeros" t-as="c" t-key="c"><option t-att-value="c"><t t-esc="c"/></option></t>
                            </select>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Empresa</label>
                        <div class="select-wrapper">
                            <select t-model="state.company">
                                <option value="all">Todas</option>
                                <t t-foreach="filtersData.empresas" t-as="c" t-key="c"><option t-att-value="c"><t t-esc="c"/></option></t>
                            </select>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Tipo</label>
                        <div class="select-wrapper">
                            <select t-model="state.dtype">
                                <option value="all">Todos</option>
                                <option value="order">Orden eliminada</option>
                                <option value="line">Línea eliminada</option>
                                <option value="qty_reduction">Reducción cantidad</option>
                                <option value="high_discount">Descuento alto</option>
                                <option value="price_reduction">Reducción precio</option>
                            </select>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Motivo</label>
                        <div class="select-wrapper">
                            <select t-model="state.reason">
                                <option value="all">Todos</option>
                                <t t-foreach="filtersData.motivos" t-as="c" t-key="c"><option t-att-value="c"><t t-esc="c"/></option></t>
                            </select>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Categoría</label>
                        <div class="select-wrapper">
                            <select t-model="state.category">
                                <option value="all">Todas</option>
                                <t t-foreach="filtersData.categorias" t-as="c" t-key="c"><option t-att-value="c"><t t-esc="c"/></option></t>
                            </select>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Producto</label>
                        <div class="select-wrapper">
                            <select t-model="state.product">
                                <option value="all">Todos</option>
                                <t t-foreach="filtersData.productos" t-as="c" t-key="c"><option t-att-value="c"><t t-esc="c"/></option></t>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="sidebar-footer">
                    <button class="btn btn-primary" t-on-click="applyFilters">Aplicar</button>
                    <button class="btn btn-secondary" t-on-click="clearFilters">Limpiar</button>
                </div>
            </aside>

            <!-- Contenido Principal -->
            <main class="main-content">
                <header class="main-header">
                    <div class="header-left">
                        <h1>Métricas de Cajeros</h1>
                    </div>
                    <div class="header-right">
                        <button class="btn btn-secondary btn-icon-only" t-on-click="toggleTheme" t-att-title="state.theme === 'light' ? 'Modo Noche' : 'Modo Día'">
                            <t t-if="state.theme === 'light'">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px; height:16px;">
                                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                </svg>
                            </t>
                            <t t-else="">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px; height:16px;">
                                    <circle cx="12" cy="12" r="5"></circle>
                                    <line x1="12" y1="1" x2="12" y2="3"></line>
                                    <line x1="12" y1="21" x2="12" y2="23"></line>
                                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                    <line x1="1" y1="12" x2="3" y2="12"></line>
                                    <line x1="21" y1="12" x2="23" y2="12"></line>
                                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                                </svg>
                            </t>
                        </button>

                        <div class="sync-status">
                            <span t-att-class="'status-dot ' + (state.loading ? 'anim-spin' : 'green')"></span>
                            <span class="status-text" t-esc="state.syncTime">Cargando...</span>
                        </div>

                        <button class="btn btn-secondary btn-icon-only" t-on-click="() => this.fetchMetrics()" title="Sincronizar ahora">
                            <svg t-att-class="state.loading ? 'icon-spin-target spinning' : 'icon-spin-target'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                            </svg>
                        </button>
                    </div>
                </header>

                <!-- KPI Cards -->
                <div class="kpi-grid">
                    <div class="kpi-card shadow-glow blue">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Total operaciones</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M9 11l3 3L22 4"></path>
                                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value" t-esc="data.kpis.total"/>
                            <div class="kpi-footer"><span class="kpi-subtext">En el período seleccionado</span></div>
                        </div>
                    </div>

                    <div class="kpi-card shadow-glow red">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Órdenes eliminadas</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                        <path d="M10 11v6M14 11v6"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value" t-esc="data.kpis.n_order"/>
                            <div class="kpi-footer"><span class="kpi-subtext">Orden completa descartada</span></div>
                        </div>
                    </div>

                    <div class="kpi-card shadow-glow amber">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Líneas eliminadas</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value" t-esc="data.kpis.n_line"/>
                            <div class="kpi-footer"><span class="kpi-subtext">Producto borrado de la orden</span></div>
                        </div>
                    </div>

                    <div class="kpi-card shadow-glow blue">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Reducciones de cantidad</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value" t-esc="data.kpis.n_qty"/>
                            <div class="kpi-footer"><span class="kpi-subtext"><t t-esc="data.kpis.units"/> unidades quitadas</span></div>
                        </div>
                    </div>

                    <div class="kpi-card shadow-glow purple">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Descuentos altos</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="19" y1="5" x2="5" y2="19"></line>
                                        <circle cx="6.5" cy="6.5" r="2.5"></circle>
                                        <circle cx="17.5" cy="17.5" r="2.5"></circle>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value" t-esc="data.kpis.n_discount"/>
                            <div class="kpi-footer"><span class="kpi-subtext">Promedio <t t-esc="data.kpis.avg_discount"/>%</span></div>
                        </div>
                    </div>

                    <div class="kpi-card shadow-glow pink">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Reducciones de precio</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
                                        <polyline points="17 18 23 18 23 12"></polyline>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value" t-esc="data.kpis.n_price"/>
                            <div class="kpi-footer"><span class="kpi-subtext">Precio bajado en línea</span></div>
                        </div>
                    </div>

                    <div class="kpi-card shadow-glow green">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Importe afectado</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"></line>
                                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value">$ <t t-esc="money(data.kpis.amount)"/></div>
                            <div class="kpi-footer"><span class="kpi-subtext">Suma de todos los eventos</span></div>
                        </div>
                    </div>

                    <div class="kpi-card shadow-glow teal">
                        <div class="kpi-card-inner">
                            <div class="kpi-meta">
                                <span class="kpi-title">Tasa de eliminación</span>
                                <div class="kpi-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                                    </svg>
                                </div>
                            </div>
                            <div class="kpi-value"><t t-esc="data.kpis.deletion_rate"/>%</div>
                            <div class="kpi-footer"><span class="kpi-subtext">Órdenes elim. / total órdenes</span></div>
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="charts-grid">
                    <div class="chart-container span-two-cols glass-panel">
                        <div class="chart-header">
                            <h3>Ranking de cajeros</h3>
                            <span class="badge">Por tipo</span>
                        </div>
                        <div class="chart-body">
                            <canvas t-ref="cashiersChart"/>
                            <p t-if="!data.cashiers.length" class="text-muted" style="text-align:center; padding-top: 40px;">Sin datos en el período.</p>
                        </div>
                    </div>

                    <div class="chart-container glass-panel">
                        <div class="chart-header"><h3>Por motivo</h3></div>
                        <div class="chart-body">
                            <canvas t-ref="reasonsChart"/>
                            <p t-if="!data.reasons.length" class="text-muted" style="text-align:center; padding-top: 40px;">Sin datos.</p>
                        </div>
                    </div>

                    <div class="chart-container span-two-cols glass-panel">
                        <div class="chart-header">
                            <h3>Tendencia diaria</h3>
                            <span class="badge">Eventos + Importe</span>
                        </div>
                        <div class="chart-body">
                            <canvas t-ref="trendChart"/>
                            <p t-if="!data.trend.length" class="text-muted" style="text-align:center; padding-top: 40px;">Sin datos.</p>
                        </div>
                    </div>
                </div>

                <!-- Tabla detalle -->
                <div>
                    <div class="section-header">
                        <div>
                            <h2>Detalle de operaciones</h2>
                            <span class="subtitle">Últimos 500 registros</span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Fecha/hora</th><th>Cajero</th><th>Tipo</th><th>Producto</th>
                                    <th class="num">Cant.</th><th class="num">Desc. %</th><th class="num">Precio</th>
                                    <th class="num">Importe</th><th>Motivo</th><th>Nota</th><th>Caja</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data.detail" t-as="d" t-key="d_index">
                                    <td t-esc="d.fecha"/>
                                    <td t-esc="d.cajero"/>
                                    <td><span t-att-class="'status-pill t-' + d.tipo" t-esc="typeLabel(d.tipo)"/></td>
                                    <td t-esc="d.producto"/>
                                    <td class="num" t-esc="d.qty"/>
                                    <td class="num">
                                        <t t-if="d.tipo === 'high_discount'"><t t-esc="d.discount"/>%</t>
                                    </td>
                                    <td class="num">
                                        <t t-if="d.tipo === 'price_reduction'">
                                            $<t t-esc="money(d.old_price)"/> → $<t t-esc="money(d.new_price)"/>
                                        </t>
                                    </td>
                                    <td class="num">$ <t t-esc="money(d.amount)"/></td>
                                    <td t-esc="d.motivo"/>
                                    <td t-esc="d.nota"/>
                                    <td t-esc="d.caja"/>
                                </tr>
                                <tr t-if="!data.detail.length" class="empty-row"><td colspan="11">Sin operaciones en el período.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </t>
</templates>
