<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_cvi_card" model="ir.sequence">
        <field name="name">Tarjeta de venta en cuotas</field>
        <field name="code">cvi.card</field>
        <field name="prefix">TARJ/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_cvi_payment" model="ir.sequence">
        <field name="name">Cobro de cuota</field>
        <field name="code">cvi.payment</field>
        <field name="prefix">COB/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_cvi_settlement" model="ir.sequence">
        <field name="name">Rendición de caja</field>
        <field name="code">cvi.settlement</field>
        <field name="prefix">REND/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_cvi_supervision_visit" model="ir.sequence">
        <field name="name">Visita de supervisión</field>
        <field name="code">cvi.supervision.visit</field>
        <field name="prefix">SUP/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
