<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stock_location_vendors" model="stock.location">
            <field name="name">Vendedores</field>
            <field name="usage">view</field>
            <field name="location_id" ref="stock.stock_location_locations"/>
            <field name="comment">Ubicación padre de la mercadería en poder de cada vendedor.</field>
        </record>

        <!-- Los muebles retirados no vuelven al stock vendible: uno usado no es el
             mismo producto que uno nuevo, y mezclarlos falsearía la disponibilidad
             de fábrica (HU-26). -->
        <record id="stock_location_recovered" model="stock.location">
            <field name="name">Recuperados</field>
            <field name="usage">internal</field>
            <field name="location_id" ref="stock.stock_location_locations"/>
            <field name="comment">Mercadería retirada a clientes que dejaron de pagar.</field>
        </record>
    </data>
</odoo>
