<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_cvi_plans" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cvi.plans</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Planes de cuotas" name="cvi_plans"
                      groups="collections_from_vendors_installments.group_cvi_manager">
                    <field name="cvi_plan_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="installment_count"/>
                            <field name="installment_amount"/>
                            <field name="frequency"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="active" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        El precio total de cada plan se calcula solo: cantidad de cuotas por
                        importe de cuota. El interés va incluido en el importe de la cuota,
                        así que el total no es una división del precio de contado. El precio
                        de lista del producto no interviene en el cálculo.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

    <!--
        Lista propia de muebles, para no depender de Inventario. Muestra la cantidad de
        planes cargados, que es el dato que se viene a mirar: un mueble sin planes no se
        puede vender en cuotas y desde la ficha de Inventario eso no se ve.
    -->
    <record id="view_cvi_product_list" model="ir.ui.view">
        <field name="name">product.template.list.cvi</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Muebles">
                <field name="name"/>
                <field name="default_code" optional="show"/>
                <field name="list_price"/>
                <field name="cvi_plan_count" string="Planes"/>
                <field name="qty_available" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_cvi_products" model="ir.actions.act_window">
        <field name="name">Muebles</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_storable', '=', True)]</field>
        <field name="context">{'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay muebles cargados</p>
            <p>Cargá el mueble y después sus planes de cuotas, en la pestaña
               "Planes de cuotas" de la ficha.</p>
        </field>
    </record>

    <record id="action_cvi_products_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_cvi_product_list"/>
        <field name="act_window_id" ref="action_cvi_products"/>
    </record>
</odoo>
