<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cvi_installment_list" model="ir.ui.view">
        <field name="name">cvi.installment.list</field>
        <field name="model">cvi.installment</field>
        <field name="arch" type="xml">
            <list string="Cuotas" create="false"
                  decoration-danger="state == 'overdue'" decoration-success="state == 'paid'">
                <field name="partner_id"/>
                <field name="street" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="sequence" string="Cuota"/>
                <field name="date_due"/>
                <field name="amount_residual" sum="A cobrar"/>
                <field name="card_residual" optional="show"/>
                <field name="collected_by_ids" widget="many2many_tags"
                       string="Cobrado por" optional="show"/>
                <field name="state"/>
                <button name="action_open_map" type="object" icon="fa-map-marker"
                        title="Abrir en el mapa (ubicación GPS de la venta)"
                        invisible="not map_url or not map_is_gps"/>
                <button name="action_open_map" type="object" icon="fa-map-o"
                        title="Abrir en el mapa (dirección del contacto, sin GPS)"
                        class="text-warning"
                        invisible="not map_url or map_is_gps"/>
                <field name="map_url" column_invisible="True"/>
                <field name="map_is_gps" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!--
        La agenda es la pantalla que el cobrador usa en la calle, en un celular. Sin un
        kanban, Odoo le muestra la lista de 9 columnas con scroll horizontal: en pantalla
        chica action_service reemplaza la vista inicial por la que indique
        mobile_view_mode (default "kanban"), pero solo si la acción ofrece una.
    -->
    <record id="view_cvi_installment_kanban" model="ir.ui.view">
        <field name="name">cvi.installment.kanban</field>
        <field name="model">cvi.installment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="date_due">
                <field name="state"/>
                <field name="currency_id"/>
                <field name="map_url"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong><field name="partner_id"/></strong>
                                <div class="text-muted small">
                                    Cuota <field name="sequence"/> · vence
                                    <field name="date_due"/>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <strong><field name="amount_residual" widget="monetary"/></strong>
                                <div class="text-muted small">
                                    saldo <field name="card_residual" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-center">
                            <div class="col-7 text-truncate">
                                <field name="street"/>
                            </div>
                            <div class="col-5 text-end">
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'pending': 'default', 'partial': 'warning', 'paid': 'success', 'overdue': 'danger'}}"/>
                            </div>
                        </div>
                        <div class="row mt-2 align-items-center">
                            <div class="col-7">
                                <!-- widget phone: en el celular es un link que llama. -->
                                <field name="phone" widget="phone"/>
                            </div>
                            <div class="col-5 text-end">
                                <button name="action_open_map" type="object"
                                        class="btn btn-sm btn-secondary"
                                        invisible="not map_url">
                                    <i class="fa fa-map-marker me-1" role="img"
                                       aria-label="Mapa"/>Mapa
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cvi_installment_form" model="ir.ui.view">
        <field name="name">cvi.installment.form</field>
        <field name="model">cvi.installment</field>
        <field name="arch" type="xml">
            <form string="Cuota">
                <header>
                    <button name="action_open_map" type="object" string="Ver en el mapa"
                            class="btn-secondary" invisible="not map_url"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,partial,paid"/>
                </header>
                <sheet>
                    <group>
                        <group string="Cliente">
                            <field name="partner_id" readonly="1"/>
                            <field name="phone" widget="phone" readonly="1"/>
                            <field name="street" readonly="1"/>
                            <field name="city" readonly="1"/>
                            <field name="map_is_gps" readonly="1"/>
                            <field name="map_url" invisible="1"/>
                        </group>
                        <group string="Cuota">
                            <field name="card_id" readonly="1"/>
                            <field name="sequence" readonly="1"/>
                            <field name="date_due" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="amount_residual" readonly="1"/>
                            <field name="collected_by_ids" widget="many2many_tags"
                                   readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cvi_installment_search" model="ir.ui.view">
        <field name="name">cvi.installment.search</field>
        <field name="model">cvi.installment</field>
        <field name="arch" type="xml">
            <search string="Cuotas">
                <field name="partner_id"/>
                <field name="card_id"/>
                <field name="collector_id"/>
                <filter name="filter_due_today" string="Vencen hoy o antes"
                        domain="[('date_due', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_unpaid" string="Impagas"
                        domain="[('state', 'in', ('pending', 'partial', 'overdue'))]"/>
                <filter name="filter_overdue" string="Vencidas"
                        domain="[('state', '=', 'overdue')]"/>
                <filter name="filter_collection" string="De cobranza"
                        domain="[('is_commission', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_partner" string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_due" string="Vencimiento"
                            context="{'group_by': 'date_due'}"/>
                    <filter name="group_by_collector" string="Cobrador"
                            context="{'group_by': 'collector_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cvi_agenda" model="ir.actions.act_window">
        <field name="name">Agenda de cobro</field>
        <field name="res_model">cvi.installment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_cvi_installment_search"/>
        <field name="domain">[('card_state', '=', 'active'), ('is_commission', '=', False)]</field>
        <field name="context">{'search_default_filter_due_today': 1, 'search_default_filter_unpaid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tenés cobros pendientes para hoy</p>
            <p>Acá aparecen las cuotas de tu cartera que vencen hoy o que quedaron atrasadas.</p>
        </field>
    </record>
</odoo>
