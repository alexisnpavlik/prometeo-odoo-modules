<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cvi_city_list" model="ir.ui.view">
        <field name="name">cvi.city.list</field>
        <field name="model">cvi.city</field>
        <field name="arch" type="xml">
            <!-- editable: cargar el padrón de ciudades es tipear una lista, no abrir
                 un formulario por cada una. -->
            <list string="Ciudades" editable="bottom">
                <field name="name"/>
                <field name="state_id" required="1"
                       options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="view_cvi_city_form" model="ir.ui.view">
        <field name="name">cvi.city.form</field>
        <field name="model">cvi.city</field>
        <field name="arch" type="xml">
            <form string="Ciudad">
                <sheet>
                    <group>
                        <field name="name" placeholder="Nombre de la ciudad"/>
                        <field name="state_id" required="1"
                               options="{'no_create': True}"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cvi_city_search" model="ir.ui.view">
        <field name="name">cvi.city.search</field>
        <field name="model">cvi.city</field>
        <field name="arch" type="xml">
            <search string="Ciudades">
                <field name="name"/>
                <field name="state_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Provincia"
                            context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cvi_cities" model="ir.actions.act_window">
        <field name="name">Ciudades</field>
        <field name="res_model">cvi.city</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cvi_city_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cargá las ciudades donde se cobra</p>
            <p>El vendedor las elige de esta lista: no puede escribirlas a mano.</p>
        </field>
    </record>
</odoo>
