<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Los grupos van fuera de noupdate para que un `-u` del módulo propague cambios
        de jerarquía a las instalaciones existentes.

        La categoría se renderiza como lista desplegable en lugar de casillas porque los
        tres grupos forman una cadena lineal de implicación: Cobrador ⊂ Vendedor ⊂
        Administrador. Odoo exige ese orden total (res.users.get_groups_by_application);
        si se rompe la cadena, la categoría vuelve a mostrarse como casillas.

        La cadena refleja la operación real: el vendedor ya cobra la primera cuota, así
        que todo vendedor es también un cobrador. La dirección inversa habilitaría a los
        cobradores de calle a crear ventas.
    -->
    <data>
        <record id="module_category_cvi" model="ir.module.category">
            <field name="name">Venta en cuotas</field>
            <field name="description">Venta domiciliaria financiada y cobranza</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_cvi_collector" model="res.groups">
            <field name="name">Cobrador</field>
            <field name="category_id" ref="module_category_cvi"/>
            <field name="comment">Acepta tarjetas enrutadas y cobra las cuotas. Solo ve su propia cartera.</field>
        </record>

        <record id="group_cvi_vendor" model="res.groups">
            <field name="name">Vendedor</field>
            <field name="category_id" ref="module_category_cvi"/>
            <field name="comment">Retira mercadería, vende en el domicilio, cobra la primera cuota y enruta la tarjeta. Ve sus propias ventas y, si además tiene cartera asignada, las tarjetas que cobra.</field>
            <field name="implied_ids" eval="[(4, ref('group_cvi_collector'))]"/>
        </record>

        <record id="group_cvi_manager" model="res.groups">
            <field name="name">Administrador de cobranzas</field>
            <field name="category_id" ref="module_category_cvi"/>
            <field name="comment">Configura el módulo, transfiere carteras y ve toda la operación.</field>
            <field name="implied_ids" eval="[(4, ref('group_cvi_vendor')), (4, ref('stock.group_stock_user'))]"/>
        </record>
        <!--
            Categoría aparte a propósito. Odoo solo renderiza una categoría como
            desplegable si sus grupos forman un orden total de implicación; meter
            Supervisor en la cadena Cobrador ⊂ Vendedor ⊂ Administrador obligaría a
            darle permisos de venta, que un supervisor de cobranza no necesita. En
            categoría propia el desplegable de roles queda intacto y la supervisión
            es una capacidad que se suma aparte.
        -->
        <record id="module_category_cvi_supervision" model="ir.module.category">
            <field name="name">Supervisión de cobranza</field>
            <field name="description">Auditoría de la cartera de los cobradores</field>
            <field name="sequence">21</field>
        </record>

        <record id="group_cvi_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_cvi_supervision"/>
            <field name="comment">Audita la cartera de los cobradores que tiene asignados. Solo ve esa cartera, no la operación completa.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Multi-empresa: nadie ve registros de empresas que no le corresponden -->
        <record id="rule_cvi_card_company" model="ir.rule">
            <field name="name">Tarjeta: multi-empresa</field>
            <field name="model_id" ref="model_cvi_card"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cvi_installment_company" model="ir.rule">
            <field name="name">Cuota: multi-empresa</field>
            <field name="model_id" ref="model_cvi_installment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cvi_payment_company" model="ir.rule">
            <field name="name">Cobro: multi-empresa</field>
            <field name="model_id" ref="model_cvi_payment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- RN-07: cada rol ve exclusivamente su propia información -->
        <record id="rule_cvi_card_vendor" model="ir.rule">
            <field name="name">Tarjeta: el vendedor ve sus ventas</field>
            <field name="model_id" ref="model_cvi_card"/>
            <field name="domain_force">[('vendor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_vendor'))]"/>
        </record>

        <record id="rule_cvi_card_collector" model="ir.rule">
            <field name="name">Tarjeta: el cobrador ve su cartera</field>
            <field name="model_id" ref="model_cvi_card"/>
            <field name="domain_force">[('collector_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_collector'))]"/>
        </record>

        <record id="rule_cvi_card_manager" model="ir.rule">
            <field name="name">Tarjeta: el administrador ve todo</field>
            <field name="model_id" ref="model_cvi_card"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_manager'))]"/>
        </record>

        <record id="rule_cvi_installment_vendor" model="ir.rule">
            <field name="name">Cuota: el vendedor ve las de sus ventas</field>
            <field name="model_id" ref="model_cvi_installment"/>
            <field name="domain_force">[('card_id.vendor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_vendor'))]"/>
        </record>

        <record id="rule_cvi_installment_collector" model="ir.rule">
            <field name="name">Cuota: el cobrador ve las de su cartera</field>
            <field name="model_id" ref="model_cvi_installment"/>
            <field name="domain_force">[('card_id.collector_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_collector'))]"/>
        </record>

        <record id="rule_cvi_installment_manager" model="ir.rule">
            <field name="name">Cuota: el administrador ve todo</field>
            <field name="model_id" ref="model_cvi_installment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_manager'))]"/>
        </record>

        <record id="rule_cvi_payment_vendor" model="ir.rule">
            <field name="name">Cobro: el vendedor ve los de sus ventas</field>
            <field name="model_id" ref="model_cvi_payment"/>
            <field name="domain_force">[('card_id.vendor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_vendor'))]"/>
        </record>

        <record id="rule_cvi_payment_collector" model="ir.rule">
            <field name="name">Cobro: el cobrador ve los de su cartera</field>
            <field name="model_id" ref="model_cvi_payment"/>
            <field name="domain_force">[('card_id.collector_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_collector'))]"/>
        </record>

        <record id="rule_cvi_payment_manager" model="ir.rule">
            <field name="name">Cobro: el administrador ve todo</field>
            <field name="model_id" ref="model_cvi_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_manager'))]"/>
        </record>

        <record id="rule_cvi_allocation_company" model="ir.rule">
            <field name="name">Imputación: multi-empresa</field>
            <field name="model_id" ref="model_cvi_allocation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cvi_allocation_vendor" model="ir.rule">
            <field name="name">Imputación: el vendedor ve las de sus ventas</field>
            <field name="model_id" ref="model_cvi_allocation"/>
            <field name="domain_force">[('card_id.vendor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_vendor'))]"/>
        </record>

        <record id="rule_cvi_allocation_collector" model="ir.rule">
            <field name="name">Imputación: el cobrador ve las de su cartera</field>
            <field name="model_id" ref="model_cvi_allocation"/>
            <field name="domain_force">[('card_id.collector_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_collector'))]"/>
        </record>

        <record id="rule_cvi_allocation_manager" model="ir.rule">
            <field name="name">Imputación: el administrador ve todo</field>
            <field name="model_id" ref="model_cvi_allocation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_manager'))]"/>
        </record>

        <record id="rule_cvi_settlement_company" model="ir.rule">
            <field name="name">Rendición: multi-empresa</field>
            <field name="model_id" ref="model_cvi_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cvi_settlement_collector" model="ir.rule">
            <field name="name">Rendición: el cobrador ve las suyas</field>
            <field name="model_id" ref="model_cvi_settlement"/>
            <field name="domain_force">[('collector_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_collector'))]"/>
        </record>

        <record id="rule_cvi_settlement_manager" model="ir.rule">
            <field name="name">Rendición: el administrador ve todas</field>
            <field name="model_id" ref="model_cvi_settlement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_manager'))]"/>
        </record>

        <!-- HU-21: el supervisor solo ve la cartera que le corresponde. -->
        <record id="rule_cvi_card_supervisor" model="ir.rule">
            <field name="name">Tarjeta: el supervisor ve la cartera que audita</field>
            <field name="model_id" ref="model_cvi_card"/>
            <field name="domain_force">[('collector_id', 'in', user.cvi_supervised_collector_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_supervisor'))]"/>
        </record>

        <record id="rule_cvi_installment_supervisor" model="ir.rule">
            <field name="name">Cuota: el supervisor ve las de la cartera que audita</field>
            <field name="model_id" ref="model_cvi_installment"/>
            <field name="domain_force">[('card_id.collector_id', 'in', user.cvi_supervised_collector_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_supervisor'))]"/>
        </record>

        <record id="rule_cvi_payment_supervisor" model="ir.rule">
            <field name="name">Cobro: el supervisor ve los de la cartera que audita</field>
            <field name="model_id" ref="model_cvi_payment"/>
            <field name="domain_force">[('card_id.collector_id', 'in', user.cvi_supervised_collector_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_supervisor'))]"/>
        </record>

        <record id="rule_cvi_visit_company" model="ir.rule">
            <field name="name">Visita: multi-empresa</field>
            <field name="model_id" ref="model_cvi_supervision_visit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cvi_visit_supervisor" model="ir.rule">
            <field name="name">Visita: el supervisor ve las suyas</field>
            <field name="model_id" ref="model_cvi_supervision_visit"/>
            <field name="domain_force">[('supervisor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_supervisor'))]"/>
        </record>

        <record id="rule_cvi_visit_manager" model="ir.rule">
            <field name="name">Visita: el administrador ve todas</field>
            <field name="model_id" ref="model_cvi_supervision_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_manager'))]"/>
        </record>

        <record id="rule_cvi_card_line_company" model="ir.rule">
            <field name="name">Línea de venta: multi-empresa</field>
            <field name="model_id" ref="model_cvi_card_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cvi_card_line_vendor" model="ir.rule">
            <field name="name">Línea de venta: el vendedor ve las de sus ventas</field>
            <field name="model_id" ref="model_cvi_card_line"/>
            <field name="domain_force">[('card_id.vendor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_vendor'))]"/>
        </record>

        <record id="rule_cvi_card_line_collector" model="ir.rule">
            <field name="name">Línea de venta: el cobrador ve las de su cartera</field>
            <field name="model_id" ref="model_cvi_card_line"/>
            <field name="domain_force">[('card_id.collector_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_collector'))]"/>
        </record>

        <record id="rule_cvi_card_line_supervisor" model="ir.rule">
            <field name="name">Línea de venta: el supervisor ve la cartera que audita</field>
            <field name="model_id" ref="model_cvi_card_line"/>
            <field name="domain_force">[('card_id.collector_id', 'in', user.cvi_supervised_collector_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_supervisor'))]"/>
        </record>

        <record id="rule_cvi_card_line_manager" model="ir.rule">
            <field name="name">Línea de venta: el administrador ve todo</field>
            <field name="model_id" ref="model_cvi_card_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cvi_manager'))]"/>
        </record>
    </data>
</odoo>
