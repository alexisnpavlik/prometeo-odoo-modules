<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_branch_transfer_list" model="ir.ui.view">
        <field name="name">stock.branch.transfer.list</field>
        <field name="model">stock.branch.transfer</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'in_transit'"
                  decoration-warning="state == 'with_diff'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="company_id" string="Origen"/>
                <field name="dest_company_id"/>
                <field name="user_id" optional="show"/>
                <field name="date_sent"/>
                <field name="date_received" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_transit'"
                       decoration-warning="state == 'with_diff'"
                       decoration-success="state in ('received', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="view_stock_branch_transfer_form" model="ir.ui.view">
        <field name="name">stock.branch.transfer.form</field>
        <field name="model">stock.branch.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Imprimir ocupa el lugar de Enviar: el doble clic no cae en Anular -->
                    <button name="%(action_report_branch_transfer)d" type="action" string="Imprimir" class="btn-primary"
                            invisible="state == 'draft'"/>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <!-- En borrador va después de Enviar y sin resaltar: el doble clic en Enviar cae en el Imprimir de arriba -->
                    <button name="%(action_report_branch_transfer)d" type="action" string="Imprimir"
                            invisible="state != 'draft'"/>
                    <button name="action_receive" type="object" string="Recibido" class="btn-primary"
                            invisible="state != 'in_transit' or not is_dest_mine"
                            confirm="¿Confirmás que llegó todo lo enviado?"/>
                    <button name="action_open_receive_diff" type="object" string="Recibido con diferencias"
                            invisible="state != 'in_transit' or not is_dest_mine"/>
                    <button name="action_close" type="object" string="Aceptar diferencias y cerrar" class="btn-primary"
                            invisible="state != 'with_diff' or not is_manager"
                            confirm="El faltante vuelve al stock de origen. ¿Cerrar el traslado?"/>
                    <button name="action_cancel" type="object" string="Anular" class="btn-outline-danger"
                            invisible="state in ('draft', 'cancel') or not is_manager"
                            confirm="Se revierte todo el stock movido por este traslado. ¿Anular?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_transit,received,closed"/>
                </header>
                <sheet>
                    <field name="is_manager" invisible="1"/>
                    <field name="is_dest_mine" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" string="Origen"
                                   readonly="state != 'draft' and not is_manager"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="dest_company_id"
                                   domain="[('id', '!=', company_id)]"
                                   context="{'branch_transfer_dest': True}"
                                   readonly="state == 'cancel' or (state != 'draft' and not is_manager)"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date_sent"/>
                            <field name="date_received"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" name="lines">
                            <field name="line_ids" readonly="state == 'cancel' or (state != 'draft' and not is_manager)">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="qty_available_origin" column_invisible="parent.state != 'draft'"
                                           decoration-danger="qty_available_origin &lt; qty_sent"/>
                                    <field name="qty_available_dest" column_invisible="parent.state != 'draft'"/>
                                    <field name="qty_sent"/>
                                    <field name="qty_received" column_invisible="parent.state in ('draft', 'in_transit')"/>
                                    <field name="uom_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Nota de remito" name="note">
                            <field name="note" placeholder="Observaciones que salen al pie del remito..."
                                   readonly="state == 'cancel'"/>
                        </page>
                        <page string="Diferencias" name="diff" invisible="not diff_note">
                            <field name="diff_note" readonly="not is_manager"/>
                        </page>
                        <page string="Movimientos de stock" name="pickings" groups="stock.group_stock_user">
                            <field name="picking_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="company_id"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="date_done"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stock_branch_transfer_search" model="ir.ui.view">
        <field name="name">stock.branch.transfer.search</field>
        <field name="model">stock.branch.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id" string="Origen"/>
                <field name="dest_company_id"/>
                <field name="line_ids" string="Producto" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="pending" string="Pendientes" domain="[('state', 'in', ('in_transit', 'with_diff'))]"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="in_transit" string="En camino" domain="[('state', '=', 'in_transit')]"/>
                <filter name="with_diff" string="Con diferencias" domain="[('state', '=', 'with_diff')]"/>
                <filter name="done" string="Recibidos / Cerrados" domain="[('state', 'in', ('received', 'closed'))]"/>
                <filter name="cancel" string="Anulados" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="group_dest" string="Destino" context="{'group_by': 'dest_company_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_branch_transfer_sent" model="ir.actions.act_window">
        <field name="name">Salidas</field>
        <field name="res_model">stock.branch.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_origin_mine', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creá un traslado para enviar mercadería a otra sucursal</p>
        </field>
    </record>

    <record id="action_branch_transfer_incoming" model="ir.actions.act_window">
        <field name="name">Entradas</field>
        <field name="res_model">stock.branch.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dest_mine', '=', True), ('state', '!=', 'draft')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay mercadería en camino hacia tus sucursales</p>
        </field>
    </record>

    <record id="action_branch_transfer_all" model="ir.actions.act_window">
        <field name="name">Todos los traslados</field>
        <field name="res_model">stock.branch.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
