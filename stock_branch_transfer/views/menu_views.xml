<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_branch_transfer_root"
              name="Traslados"
              web_icon="stock_branch_transfer,static/description/icon.png"
              groups="group_branch_transfer_user"
              sequence="45"/>

    <menuitem id="menu_branch_transfer_sent"
              name="Salidas"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_sent"
              sequence="10"/>

    <menuitem id="menu_branch_transfer_incoming"
              name="Entradas"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_incoming"
              sequence="20"/>

    <menuitem id="menu_branch_transfer_all"
              name="Todos"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_all"
              groups="group_branch_transfer_manager"
              sequence="30"/>

    <record id="action_branch_transfer_metrics" model="ir.actions.client">
        <field name="name">Métricas de traslados</field>
        <field name="tag">stock_branch_transfer.metrics_dashboard</field>
    </record>

    <!-- Muestra costos: sólo managers (el controlador vuelve a chequear el grupo) -->
    <menuitem id="menu_branch_transfer_metrics"
              name="Métricas"
              parent="menu_branch_transfer_root"
              action="action_branch_transfer_metrics"
              groups="group_branch_transfer_manager"
              sequence="40"/>
</odoo>
