<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Packs: productos combo armados con pos_promotions (is_promotion_pack). -->
    <record id="promotion_pack_list" model="ir.ui.view">
        <field name="name">product.template.list.promotion.pack</field>
        <field name="model">product.template</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <list string="Promociones" decoration-danger="promotion_expired">
                <field name="promotion_expired" column_invisible="1"/>
                <field name="name" string="Promoción"/>
                <field name="promotion_pack_line_ids" widget="many2many_tags" string="Productos"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="promotion_pack_regular_price" widget="monetary"/>
                <field name="promotion_price_mode"/>
                <field name="promotion_price_above_regular" column_invisible="1"/>
                <field name="list_price" string="Precio de la promoción" widget="monetary"
                       invisible="promotion_price_mode == 'percent'"
                       decoration-danger="promotion_price_above_regular"/>
                <field name="promotion_discount_percent" invisible="promotion_price_mode != 'percent'"/>
                <field name="promotion_pack_saving" widget="monetary"/>
                <field name="promotion_company_ids" widget="many2many_tags" optional="show"/>
                <field name="promotion_date_start" optional="show"/>
                <field name="promotion_date_end" optional="show"/>
                <field name="promotion_status" widget="badge"
                       decoration-success="promotion_status == 'active'"
                       decoration-info="promotion_status == 'scheduled'"
                       decoration-danger="promotion_status == 'expired'"/>
                <field name="active" widget="boolean_toggle" string="Activo"/>
            </list>
        </field>
    </record>

    <record id="promotion_pack_form" model="ir.ui.view">
        <field name="name">product.template.form.promotion.pack</field>
        <field name="model">product.template</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form string="Promoción">
                <sheet>
                    <field name="is_promotion_pack" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="promotion_pack_auto_price" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="promotion_allowed_company_ids" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Nombre de la promoción"/>
                        <h1><field name="name" placeholder="p. ej. Fernet + Coca-Cola"/></h1>
                    </div>
                    <!-- Sin categoría del POS: el pack se muestra siempre (pos_config.py y product_screen_patch.js). -->
                    <group>
                        <group>
                            <field name="promotion_price_mode" widget="radio"/>
                            <field name="promotion_price_above_regular" invisible="1"/>
                            <field name="list_price" string="Precio de la promoción" widget="monetary"
                                   invisible="promotion_price_mode == 'percent'"
                                   decoration-danger="promotion_price_above_regular"/>
                            <div colspan="2" class="text-danger small" invisible="not promotion_price_above_regular">
                                Más cara que los productos sueltos: en las sucursales donde los sueltos
                                cuesten menos, no se aplica.
                            </div>
                            <field name="promotion_discount_percent"
                                   invisible="promotion_price_mode != 'percent'"
                                   required="promotion_price_mode == 'percent'"/>
                            <field name="promotion_pack_regular_price" widget="monetary"/>
                            <field name="promotion_pack_saving" widget="monetary"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle" string="Activo"/>
                            <field name="promotion_company_ids" widget="many2many_tags"
                                   domain="[('id', 'in', promotion_allowed_company_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="promotion_use_dates"/>
                            <field name="promotion_date_start" invisible="not promotion_use_dates"/>
                            <field name="promotion_date_end" invisible="not promotion_use_dates"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        Precio normal y ahorro son de referencia, con el precio de venta de la ficha.
                        En el POS la promoción descuenta sobre el precio de cada sucursal (su lista de
                        precios), sin modificarlo.
                    </div>
                    <field name="promotion_pack_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="quantity"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="lst_price" widget="monetary"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promotion_pack_search" model="ir.ui.view">
        <field name="name">product.template.search.promotion.pack</field>
        <field name="model">product.template</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Promoción"/>
                <filter name="inactive" string="Inactivos" domain="[('active', '=', False)]"/>
                <filter name="expired" string="Vencidas"
                        domain="[('promotion_date_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <record id="action_promotion_packs" model="ir.actions.act_window">
        <field name="name">Promociones</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_promotion_pack', '=', True)]</field>
        <field name="context">{
            'default_is_promotion_pack': True,
            'default_available_in_pos': True,
            'default_sale_ok': True,
            'default_purchase_ok': False,
        }</field>
        <field name="search_view_id" ref="promotion_pack_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('promotion_pack_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('promotion_pack_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creá una promoción</p>
            <p>Varios productos juntos a un precio: en el POS se agregan con un toque y descuentan el stock de cada producto.</p>
        </field>
    </record>
</odoo>
