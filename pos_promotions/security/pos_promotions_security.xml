<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Precio por lista: cada usuario ve solo los precios de las listas de sus empresas activas
         (si no, el formulario falla al mostrar el nombre de una lista de otra empresa). -->
    <record id="pos_promotion_price_company_rule" model="ir.rule">
        <field name="name">Promoción: precio por lista multiempresa</field>
        <field name="model_id" ref="model_pos_promotion_price"/>
        <field name="domain_force">['|', ('pricelist_id.company_id', '=', False), ('pricelist_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
