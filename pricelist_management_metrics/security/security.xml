<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fuera de "Extra Rights" (solo debug): categoría propia con un único grupo
         = desplegable visible. El padre "Métricas" se repite en cada módulo de
         métricas con mismo nombre y secuencia; Odoo los agrupa en un solo bloque. -->
    <record id="module_category_metrics_parent" model="ir.module.category">
        <field name="name">Métricas</field>
        <field name="sequence">90</field>
    </record>

    <record id="module_category_metrics" model="ir.module.category">
        <field name="name">Métricas de Precios por Sucursal</field>
        <field name="parent_id" ref="module_category_metrics_parent"/>
    </record>

    <record id="group_pricelist_metrics_user" model="res.groups">
        <field name="name">Acceso</field>
        <field name="category_id" ref="module_category_metrics"/>
        <field name="comment">Permite acceder al dashboard comparativo de precios base vs listas de precios por sucursal/empresa.</field>
    </record>
</odoo>
