<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_barcode_price_rounding" model="ir.ui.view">
        <field name="name">res.config.settings.form.barcode.price.rounding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Redondeo de precios POS" string="Redondeo de precios POS"
                     name="pos_barcode_price_rounding" groups="point_of_sale.group_pos_manager">
                    <block title="Códigos de barra con precio (productos por kilo)" name="barcode_price_rounding_block">
                        <setting string="Redondear precio escaneado"
                                 help="Redondea el precio que trae el código de barra al escanearlo en el POS.">
                            <field name="barcode_price_rounding_enabled"/>
                        </setting>
                        <setting string="Múltiplo"
                                 help="Ej.: 100 → 3450 pasa a 3500. 0 o 1 = sin redondeo."
                                 invisible="not barcode_price_rounding_enabled">
                            <field name="barcode_price_rounding_step"/>
                        </setting>
                        <setting string="Modo"
                                 help="Más cercano: 3449 → 3400, 3450 → 3500. Arriba: 3401 → 3500. Abajo: 3499 → 3400."
                                 invisible="not barcode_price_rounding_enabled">
                            <field name="barcode_price_rounding_method"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
